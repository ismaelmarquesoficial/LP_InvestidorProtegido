    <!-- Formulário — ESCURO -->
    <section class="section form-section" id="formulario">
        <div class="container">
            <div class="form-wrap">
                <div class="form-frame reveal">

                    <!-- ===== Tela de abertura ===== -->
                    <div class="wz-screen active" data-screen="intro">
                        <p class="wz-intro-sub">Mercado financeiro e consórcios</p>
                        <h2 class="wz-intro-title">Candidate-se para Consultor Comercial</h2>
                        <p class="wz-intro-desc">Conte-nos sobre sua experiência, seu perfil comercial e seus objetivos profissionais. O formulário é dividido em etapas rápidas.</p>
                        <button type="button" class="btn btn-primary" id="wzStart"><span>Iniciar qualificação</span></button>
                    </div>

                    <!-- ===== Wizard ===== -->
                    <div class="wz-screen" data-screen="wizard">
                        <div class="wz-progress">
                            <div class="wz-progress-head">
                                <span class="wz-progress-label" id="wzLabel" aria-live="polite">Etapa <b>1</b> de 11 — Dados pessoais</span>
                                <span class="wz-progress-pct" id="wzPct">9%</span>
                            </div>
                            <div class="wz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="9" aria-label="Progresso da qualificação">
                                <div class="wz-progress-fill" id="wzFill"></div>
                            </div>
                        </div>

                        <form id="qualForm" novalidate>

                            <!-- Etapa 1 — Dados pessoais -->
                            <div class="wz-step active" data-step="1">
                                <h3 class="wz-title">Primeiro, fale sobre você</h3>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="q_nome">Nome completo <span class="req">*</span></label>
                                        <input type="text" id="q_nome" name="nome" class="form-input" placeholder="Seu nome completo" autocomplete="name" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="q_idade">Idade <span class="req">*</span></label>
                                        <input type="number" id="q_idade" name="idade" class="form-input" placeholder="00" min="16" max="99" inputmode="numeric" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="q_email">E-mail <span class="req">*</span></label>
                                    <input type="email" id="q_email" name="email" class="form-input" placeholder="seu@email.com" autocomplete="email" required>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="q_telefone">Telefone <span class="req">*</span></label>
                                        <input type="tel" id="q_telefone" name="telefone" class="form-input" placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="q_whatsapp">WhatsApp <span class="req">*</span></label>
                                        <input type="tel" id="q_whatsapp" name="whatsapp" class="form-input" placeholder="(00) 00000-0000" inputmode="tel" required>
                                    </div>
                                </div>

                                <label class="wz-check">
                                    <input type="checkbox" id="q_mesmoZap">
                                    <span class="wz-check-box"></span>
                                    <span class="wz-check-text">Meu telefone também é meu WhatsApp</span>
                                </label>

                                <p class="wz-error" id="err1"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 2 — Localização e redes -->
                            <div class="wz-step" data-step="2">
                                <h3 class="wz-title">Onde podemos encontrar você?</h3>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="q_cidade">Cidade <span class="req">*</span></label>
                                        <input type="text" id="q_cidade" name="cidade" class="form-input" placeholder="Ex: Brasília" autocomplete="address-level2" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="q_estado">Estado <span class="req">*</span></label>
                                        <select id="q_estado" name="estado" class="form-input" required>
                                            <option value="">Selecione</option>
                                            <option value="AC">Acre</option><option value="AL">Alagoas</option>
                                            <option value="AP">Amapá</option><option value="AM">Amazonas</option>
                                            <option value="BA">Bahia</option><option value="CE">Ceará</option>
                                            <option value="DF">Distrito Federal</option><option value="ES">Espírito Santo</option>
                                            <option value="GO">Goiás</option><option value="MA">Maranhão</option>
                                            <option value="MT">Mato Grosso</option><option value="MS">Mato Grosso do Sul</option>
                                            <option value="MG">Minas Gerais</option><option value="PA">Pará</option>
                                            <option value="PB">Paraíba</option><option value="PR">Paraná</option>
                                            <option value="PE">Pernambuco</option><option value="PI">Piauí</option>
                                            <option value="RJ">Rio de Janeiro</option><option value="RN">Rio Grande do Norte</option>
                                            <option value="RS">Rio Grande do Sul</option><option value="RO">Rondônia</option>
                                            <option value="RR">Roraima</option><option value="SC">Santa Catarina</option>
                                            <option value="SP">São Paulo</option><option value="SE">Sergipe</option>
                                            <option value="TO">Tocantins</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="q_linkedin">LinkedIn</label>
                                        <input type="text" id="q_linkedin" name="linkedin" class="form-input" placeholder="linkedin.com/in/seu-perfil">
                                    </div>
                                    <div class="form-group">
                                        <label for="q_instagram">Instagram</label>
                                        <input type="text" id="q_instagram" name="instagram" class="form-input" placeholder="@seuusuario">
                                    </div>
                                </div>
                                <p class="wz-hint">LinkedIn e Instagram são opcionais.</p>

                                <p class="wz-error" id="err2"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 3 — Atuação profissional atual -->
                            <div class="wz-step" data-step="3">
                                <h3 class="wz-title">Em qual área você trabalha atualmente?</h3>

                                <span class="wz-q">Atualmente você trabalha com <span class="req">*</span></span>
                                <p class="wz-hint">Pode marcar mais de uma opção.</p>
                                <div class="opt-grid cols" data-group="atuacaoAtual">
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Mercado financeiro"><span class="opt-face">Mercado financeiro</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Consórcio"><span class="opt-face">Consórcio</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Seguro"><span class="opt-face">Seguro</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Imóveis"><span class="opt-face">Imóveis</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Representação comercial"><span class="opt-face">Representação comercial</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Vendas internas"><span class="opt-face">Vendas internas</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Empreendedor"><span class="opt-face">Empreendedor</span></label>
                                    <label class="opt"><input type="checkbox" name="atuacaoAtual" value="Outro" id="q_atuacaoOutro"><span class="opt-face">Outro</span></label>
                                </div>

                                <div class="wz-cond" id="condOutraAtuacao">
                                    <div class="form-group">
                                        <label for="q_outraAtuacao">Qual é a sua área de atuação? <span class="req">*</span></label>
                                        <input type="text" id="q_outraAtuacao" name="outraAtuacao" class="form-input" placeholder="Descreva sua área">
                                    </div>
                                </div>

                                <p class="wz-error" id="err3"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 4 — Experiência comercial -->
                            <div class="wz-step" data-step="4">
                                <h3 class="wz-title">Qual é a sua experiência com vendas?</h3>

                                <span class="wz-q">Quanto tempo possui de experiência comercial? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="tempoExperienciaComercial">
                                    <label class="opt"><input type="radio" name="tempoExperienciaComercial" value="Nunca vendi"><span class="opt-face">Nunca vendi</span></label>
                                    <label class="opt"><input type="radio" name="tempoExperienciaComercial" value="Menos de 1 ano"><span class="opt-face">Menos de 1 ano</span></label>
                                    <label class="opt"><input type="radio" name="tempoExperienciaComercial" value="De 1 a 3 anos"><span class="opt-face">De 1 a 3 anos</span></label>
                                    <label class="opt"><input type="radio" name="tempoExperienciaComercial" value="De 3 a 5 anos"><span class="opt-face">De 3 a 5 anos</span></label>
                                    <label class="opt"><input type="radio" name="tempoExperienciaComercial" value="Mais de 5 anos"><span class="opt-face">Mais de 5 anos</span></label>
                                </div>

                                <span class="wz-q">Com quais áreas você já trabalhou?</span>
                                <p class="wz-hint">Pode marcar mais de uma. Vale também experiência operacional, sem venda direta.</p>
                                <div class="opt-grid" data-group="areasExperiencia">
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Consórcio"><span class="opt-face">Consórcio</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Seguro"><span class="opt-face">Seguro</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Previdência"><span class="opt-face">Previdência</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Investimentos"><span class="opt-face">Investimentos</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Crédito"><span class="opt-face">Crédito</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Imóveis"><span class="opt-face">Imóveis</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Empresas"><span class="opt-face">Empresas</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="B2B"><span class="opt-face">B2B</span></label>
                                    <label class="opt"><input type="checkbox" name="areasExperiencia" value="Alta renda"><span class="opt-face">Alta renda</span></label>
                                </div>

                                <p class="wz-error" id="err4"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 5 — Carteira de clientes -->
                            <div class="wz-step" data-step="5">
                                <h3 class="wz-title">Você já possui uma rede de clientes?</h3>

                                <span class="wz-q">Você possui carteira de clientes? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="possuiCarteira">
                                    <label class="opt"><input type="radio" name="possuiCarteira" value="Sim"><span class="opt-face">Sim</span></label>
                                    <label class="opt"><input type="radio" name="possuiCarteira" value="Não"><span class="opt-face">Não</span></label>
                                </div>

                                <div class="wz-cond" id="condQtdClientes">
                                    <span class="wz-q">Quantos clientes possui aproximadamente? <span class="req">*</span></span>
                                    <div class="opt-grid" data-group="quantidadeClientes">
                                        <label class="opt"><input type="radio" name="quantidadeClientes" value="Até 20"><span class="opt-face">Até 20</span></label>
                                        <label class="opt"><input type="radio" name="quantidadeClientes" value="De 21 a 50"><span class="opt-face">De 21 a 50</span></label>
                                        <label class="opt"><input type="radio" name="quantidadeClientes" value="De 51 a 100"><span class="opt-face">De 51 a 100</span></label>
                                        <label class="opt"><input type="radio" name="quantidadeClientes" value="De 101 a 300"><span class="opt-face">De 101 a 300</span></label>
                                        <label class="opt"><input type="radio" name="quantidadeClientes" value="Mais de 300"><span class="opt-face">Mais de 300</span></label>
                                    </div>
                                </div>

                                <p class="wz-error" id="err5"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 6 — Certificações -->
                            <div class="wz-step" data-step="6">
                                <h3 class="wz-title">Você possui alguma certificação profissional?</h3>

                                <span class="wz-q">Selecione todas as certificações que possui <span class="req">*</span></span>
                                <p class="wz-hint">Não ter certificação não impede a candidatura.</p>
                                <div class="opt-grid" data-group="certificacoes">
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="CPA-10"><span class="opt-face">CPA-10</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="CPA-20"><span class="opt-face">CPA-20</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="CEA"><span class="opt-face">CEA</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="CFP"><span class="opt-face">CFP</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="ANCORD"><span class="opt-face">ANCORD</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="SUSEP"><span class="opt-face">SUSEP</span></label>
                                    <label class="opt"><input type="checkbox" name="certificacoes" value="Nenhuma" id="q_certNenhuma"><span class="opt-face">Nenhuma</span></label>
                                </div>

                                <p class="wz-error" id="err6"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 7 — Estrutura e disponibilidade -->
                            <div class="wz-step" data-step="7">
                                <h3 class="wz-title">Qual é sua disponibilidade para essa oportunidade?</h3>

                                <span class="wz-q">Quanto tempo você pode dedicar semanalmente? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="horasSemanais">
                                    <label class="opt"><input type="radio" name="horasSemanais" value="Até 10 horas por semana"><span class="opt-face">Até 10 horas</span></label>
                                    <label class="opt"><input type="radio" name="horasSemanais" value="De 11 a 20 horas"><span class="opt-face">De 11 a 20 horas</span></label>
                                    <label class="opt"><input type="radio" name="horasSemanais" value="De 21 a 30 horas"><span class="opt-face">De 21 a 30 horas</span></label>
                                    <label class="opt"><input type="radio" name="horasSemanais" value="De 31 a 40 horas"><span class="opt-face">De 31 a 40 horas</span></label>
                                    <label class="opt"><input type="radio" name="horasSemanais" value="Mais de 40 horas"><span class="opt-face">Mais de 40 horas</span></label>
                                </div>

                                <span class="wz-q">Você possui veículo próprio? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="veiculoProprio">
                                    <label class="opt"><input type="radio" name="veiculoProprio" value="Sim"><span class="opt-face">Sim</span></label>
                                    <label class="opt"><input type="radio" name="veiculoProprio" value="Não"><span class="opt-face">Não</span></label>
                                </div>

                                <span class="wz-q">Você possui notebook? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="possuiNotebook">
                                    <label class="opt"><input type="radio" name="possuiNotebook" value="Sim"><span class="opt-face">Sim</span></label>
                                    <label class="opt"><input type="radio" name="possuiNotebook" value="Não"><span class="opt-face">Não</span></label>
                                </div>

                                <span class="wz-q">Tem disponibilidade para capacitação, caso a oportunidade exija? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="participaTreinamentos">
                                    <label class="opt"><input type="radio" name="participaTreinamentos" value="Sim"><span class="opt-face">Sim</span></label>
                                    <label class="opt"><input type="radio" name="participaTreinamentos" value="Não"><span class="opt-face">Não</span></label>
                                </div>

                                <p class="wz-error" id="err7"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 8 — Momento financeiro -->
                            <div class="wz-step" data-step="8">
                                <h3 class="wz-title">Conte-nos sobre seu momento atual</h3>

                                <span class="wz-q">Qual é sua renda mensal hoje? <span class="req">*</span></span>
                                <div class="opt-grid" data-group="rendaAtual">
                                    <label class="opt"><input type="radio" name="rendaAtual" value="Até R$ 2 mil"><span class="opt-face">Até R$ 2 mil</span></label>
                                    <label class="opt"><input type="radio" name="rendaAtual" value="De R$ 2 mil a R$ 5 mil"><span class="opt-face">De R$ 2 mil a R$ 5 mil</span></label>
                                    <label class="opt"><input type="radio" name="rendaAtual" value="De R$ 5 mil a R$ 10 mil"><span class="opt-face">De R$ 5 mil a R$ 10 mil</span></label>
                                    <label class="opt"><input type="radio" name="rendaAtual" value="De R$ 10 mil a R$ 20 mil"><span class="opt-face">De R$ 10 mil a R$ 20 mil</span></label>
                                    <label class="opt"><input type="radio" name="rendaAtual" value="Acima de R$ 20 mil"><span class="opt-face">Acima de R$ 20 mil</span></label>
                                </div>

                                <div class="form-group">
                                    <label for="q_rendaDesejada">Quanto deseja ganhar nos próximos 12 meses? <span class="req">*</span></label>
                                    <input type="text" id="q_rendaDesejada" name="rendaDesejada12Meses" class="form-input" placeholder="R$ 0,00" inputmode="numeric" required>
                                </div>
                                <p class="wz-hint">Informe uma meta <strong>mensal</strong> de renda que deseja alcançar nos próximos 12 meses. Isso evita a dúvida entre informar renda mensal ou o total acumulado no período.</p>

                                <p class="wz-error" id="err8"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 9 — Motivação -->
                            <div class="wz-step" data-step="9">
                                <h3 class="wz-title">O que você busca para sua carreira?</h3>

                                <span class="wz-q">Qual é sua maior motivação? <span class="req">*</span></span>
                                <p class="wz-hint">Escolha apenas uma.</p>
                                <div class="opt-grid" data-group="maiorMotivacao">
                                    <label class="opt"><input type="radio" name="maiorMotivacao" value="Ganhar mais"><span class="opt-face">Ganhar mais</span></label>
                                    <label class="opt"><input type="radio" name="maiorMotivacao" value="Mudança de carreira"><span class="opt-face">Mudança de carreira</span></label>
                                    <label class="opt"><input type="radio" name="maiorMotivacao" value="Liberdade"><span class="opt-face">Liberdade</span></label>
                                    <label class="opt"><input type="radio" name="maiorMotivacao" value="Crescimento"><span class="opt-face">Crescimento</span></label>
                                    <label class="opt"><input type="radio" name="maiorMotivacao" value="Mercado financeiro"><span class="opt-face">Mercado financeiro</span></label>
                                </div>

                                <p class="wz-error" id="err9"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Continuar</span></button>
                                </div>
                            </div>

                            <!-- Etapa 10 — Autoavaliação comercial -->
                            <div class="wz-step" data-step="10">
                                <h3 class="wz-title">Como você avalia sua habilidade comercial?</h3>

                                <span class="wz-q">De 0 a 10, qual nota você dá para sua habilidade comercial? <span class="req">*</span></span>
                                <div class="scale-row" data-group="habilidadeComercial">
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="0"><span class="scale-face">0</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="1"><span class="scale-face">1</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="2"><span class="scale-face">2</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="3"><span class="scale-face">3</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="4"><span class="scale-face">4</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="5"><span class="scale-face">5</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="6"><span class="scale-face">6</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="7"><span class="scale-face">7</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="8"><span class="scale-face">8</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="9"><span class="scale-face">9</span></label>
                                    <label class="scale-opt"><input type="radio" name="habilidadeComercial" value="10"><span class="scale-face">10</span></label>
                                </div>
                                <div class="scale-legend">
                                    <span>0 — Ainda preciso desenvolver</span>
                                    <span>5 — Nível intermediário</span>
                                    <span>10 — Excelente domínio</span>
                                </div>

                                <p class="wz-error" id="err10"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="button" class="btn btn-primary wz-next"><span>Revisar respostas</span></button>
                                </div>
                            </div>

                            <!-- Etapa 11 — Revisão e consentimento -->
                            <div class="wz-step" data-step="11">
                                <h3 class="wz-title">Revise sua qualificação</h3>
                                <p class="wz-hint">Confira suas respostas antes de enviar. Caso necessário, você pode voltar e editar qualquer etapa.</p>

                                <div id="wzReview"></div>

                                <label class="wz-check" style="margin-top:2rem;">
                                    <input type="checkbox" id="q_consentimento" name="consentimento" required>
                                    <span class="wz-check-box"></span>
                                    <span class="wz-check-text">Declaro que as informações fornecidas são verdadeiras e autorizo o tratamento dos meus dados para análise do meu perfil profissional, conforme a <a href="#" id="linkPrivacidade">Política de Privacidade</a>.</span>
                                </label>

                                <p class="wz-error" id="err11"></p>
                                <div class="wz-nav">
                                    <button type="button" class="btn btn-ghost wz-back"><span>Voltar</span></button>
                                    <button type="submit" class="btn btn-primary" id="wzSubmit"><span>Enviar minha qualificação</span></button>
                                </div>
                            </div>

                        </form>
                    </div>

                    <!-- ===== Tela de confirmação ===== -->
                    <div class="wz-screen" data-screen="sucesso">
                        <div class="wz-done">
                            <div class="wz-done-mark">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M20 6L9 17l-5-5"/>
                                </svg>
                            </div>
                            <h2 class="wz-done-title">Qualificação enviada com sucesso!</h2>
                            <p class="wz-done-desc">Recebemos suas informações. Caso seu perfil avance no processo de seleção, a empresa poderá entrar em contato por telefone, WhatsApp ou e-mail.</p>
                            <p class="wz-done-inst">Planeje hoje. Conquiste amanhã.</p>
                            <button type="button" class="btn btn-ghost" id="wzRestart"><span>Voltar ao início</span></button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

