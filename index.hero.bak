                    <a href="https://wa.me/" aria-label="WhatsApp">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </footer>


    <script>
        /* =========================================================
           CONFIGURE AQUI O DESTINO DAS CANDIDATURAS
           Cole a URL do webhook (Make, n8n, Zapier, Apps Script,
           Formspree...). Enquanto estiver vazia, o botão de envio
           mostra um erro explícito — nunca um sucesso falso.
           ========================================================= */
        const ENDPOINT_QUALIFICACAO = '';

        /* ---------- Interface geral ---------- */
        function toggleMobile() {
            const nav = document.getElementById('mobileNav');
            nav.classList.toggle('active');
            document.body.style.overflow = nav.classList.contains('active') ? 'hidden' : '';
        }

        window.addEventListener('scroll', () => {
            document.getElementById('header').classList.toggle('scrolled', window.scrollY > 60);
        });

        const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });
        document.querySelectorAll('.reveal, .line-reveal').forEach(el => obs.observe(el));

        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href !== '#') {
                    e.preventDefault();
                    const t = document.querySelector(href);
                    if (t) window.scrollTo({ top: t.getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
                    const nav = document.getElementById('mobileNav');
                    if (nav && nav.classList.contains('active')) toggleMobile();
                }
            });
        });

        /* =========================================================
           Formulário de qualificação — 11 etapas
           ========================================================= */
        (function () {
            const form = document.getElementById('qualForm');
            if (!form) return;

            const ETAPAS = [
                { n: 1,  nome: 'Dados pessoais',           pct: 9   },
                { n: 2,  nome: 'Localização e redes',      pct: 18  },
                { n: 3,  nome: 'Atuação atual',            pct: 27  },
                { n: 4,  nome: 'Experiência',              pct: 36  },
                { n: 5,  nome: 'Carteira de clientes',     pct: 45  },
                { n: 6,  nome: 'Certificações',            pct: 55  },
                { n: 7,  nome: 'Disponibilidade',          pct: 64  },
                { n: 8,  nome: 'Momento financeiro',       pct: 73  },
                { n: 9,  nome: 'Motivação',                pct: 82  },
                { n: 10, nome: 'Autoavaliação',            pct: 91  },
                { n: 11, nome: 'Revisão',                  pct: 100 }
            ];
            const TOTAL = ETAPAS.length;
            let atual = 1;
            let enviando = false;

            const $  = (s, r) => (r || document).querySelector(s);
            const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
            const passo = n => $('.wz-step[data-step="' + n + '"]');
            const tela  = n => $('.wz-screen[data-screen="' + n + '"]');

            /* ---------- Máscaras ---------- */
            function mascaraTelefone(v) {
                const d = v.replace(/\D/g, '').slice(0, 11);
                if (d.length <= 2) return d.length ? '(' + d : '';
                if (d.length <= 6) return '(' + d.slice(0, 2) + ') ' + d.slice(2);
                if (d.length <= 10) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6);
                return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7);
            }
            function mascaraMoeda(v) {
                const d = v.replace(/\D/g, '').slice(0, 11);
                if (!d) return '';
                const n = (parseInt(d, 10) / 100).toFixed(2);
                return 'R$ ' + n.replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            }

            const elTel = $('#q_telefone'), elZap = $('#q_whatsapp'), elMesmo = $('#q_mesmoZap');
            elTel.addEventListener('input', () => {
                elTel.value = mascaraTelefone(elTel.value);
                if (elMesmo.checked) elZap.value = elTel.value;
            });
            elZap.addEventListener('input', () => { elZap.value = mascaraTelefone(elZap.value); });
            elMesmo.addEventListener('change', () => {
                if (elMesmo.checked) { elZap.value = elTel.value; elZap.readOnly = true; }
                else { elZap.readOnly = false; }
            });

            const elRenda = $('#q_rendaDesejada');
            elRenda.addEventListener('input', () => { elRenda.value = mascaraMoeda(elRenda.value); });

            /* ---------- Regras condicionais ---------- */
            const condOutra = $('#condOutraAtuacao'), inOutra = $('#q_outraAtuacao');
            $('#q_atuacaoOutro').addEventListener('change', function () {
                condOutra.classList.toggle('open', this.checked);
                if (!this.checked) inOutra.value = '';
            });

            const condQtd = $('#condQtdClientes');
            $$('input[name="possuiCarteira"]').forEach(r => r.addEventListener('change', function () {
                const sim = this.value === 'Sim';
                condQtd.classList.toggle('open', sim);
                if (!sim) $$('input[name="quantidadeClientes"]').forEach(x => { x.checked = false; });
            }));

            const certNenhuma = $('#q_certNenhuma');
            $$('input[name="certificacoes"]').forEach(c => c.addEventListener('change', function () {
                if (this === certNenhuma) {
                    if (this.checked) $$('input[name="certificacoes"]').forEach(x => { if (x !== certNenhuma) x.checked = false; });
                } else if (this.checked) {
                    certNenhuma.checked = false;
                }
            }));

            /* ---------- Validação ---------- */
            function erro(n, msg, alvo) {
                const el = $('#err' + n);
                el.textContent = msg;
                el.classList.add('show');
                if (alvo) {
                    alvo.classList.add('wz-invalid');
                    if (typeof alvo.focus === 'function') alvo.focus({ preventScroll: false });
                }
                return false;
            }
            function limparErro(n) {
                const el = $('#err' + n);
                el.textContent = '';
                el.classList.remove('show');
                $$('.wz-invalid', passo(n)).forEach(x => x.classList.remove('wz-invalid'));
            }
            const marcados = nome => $$('input[name="' + nome + '"]:checked');
            const escolhido = nome => { const c = marcados(nome)[0]; return c ? c.value : ''; };
            function grupo(n, nome) { return $('[data-group="' + nome + '"]', passo(n)); }

            function validar(n) {
                limparErro(n);
                const vazio = el => !el.value.trim();

                if (n === 1) {
                    if (vazio($('#q_nome'))) return erro(1, 'Informe seu nome completo.', $('#q_nome'));
                    const idade = parseInt($('#q_idade').value, 10);
                    if (!idade || idade < 16 || idade > 99) return erro(1, 'Informe uma idade entre 16 e 99.', $('#q_idade'));
                    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test($('#q_email').value.trim())) return erro(1, 'Informe um e-mail válido.', $('#q_email'));
                    if ($('#q_telefone').value.replace(/\D/g, '').length < 10) return erro(1, 'Informe um telefone completo com DDD.', $('#q_telefone'));
                    if ($('#q_whatsapp').value.replace(/\D/g, '').length < 10) return erro(1, 'Informe um WhatsApp completo com DDD.', $('#q_whatsapp'));
                    return true;
                }
                if (n === 2) {
                    if (vazio($('#q_cidade'))) return erro(2, 'Informe sua cidade.', $('#q_cidade'));
                    if (vazio($('#q_estado'))) return erro(2, 'Selecione seu estado.', $('#q_estado'));
                    return true;
                }
                if (n === 3) {
                    if (!marcados('atuacaoAtual').length) return erro(3, 'Selecione ao menos uma área de atuação.', grupo(3, 'atuacaoAtual'));
                    if ($('#q_atuacaoOutro').checked && vazio(inOutra)) return erro(3, 'Descreva qual é a sua área de atuação.', inOutra);
                    return true;
                }
                if (n === 4) {
                    if (!escolhido('tempoExperienciaComercial')) return erro(4, 'Selecione seu tempo de experiência comercial.', grupo(4, 'tempoExperienciaComercial'));
                    return true;
                }
                if (n === 5) {
                    if (!escolhido('possuiCarteira')) return erro(5, 'Informe se possui carteira de clientes.', grupo(5, 'possuiCarteira'));
                    if (escolhido('possuiCarteira') === 'Sim' && !escolhido('quantidadeClientes')) return erro(5, 'Informe a quantidade aproximada de clientes.', grupo(5, 'quantidadeClientes'));
                    return true;
                }
                if (n === 6) {
                    if (!marcados('certificacoes').length) return erro(6, 'Selecione suas certificações ou marque "Nenhuma".', grupo(6, 'certificacoes'));
                    return true;
                }
                if (n === 7) {
                    const obrig = [
                        ['horasSemanais', 'Informe quantas horas pode dedicar por semana.'],
                        ['veiculoProprio', 'Informe se possui veículo próprio.'],
                        ['possuiNotebook', 'Informe se possui notebook.'],
                        ['participaTreinamentos', 'Informe sua disponibilidade para capacitação.']
                    ];
                    for (const [campo, msg] of obrig) {
                        if (!escolhido(campo)) return erro(7, msg, grupo(7, campo));
                    }
                    return true;
                }
                if (n === 8) {
                    if (!escolhido('rendaAtual')) return erro(8, 'Selecione sua renda mensal atual.', grupo(8, 'rendaAtual'));
                    if (elRenda.value.replace(/\D/g, '') === '' || parseInt(elRenda.value.replace(/\D/g, ''), 10) === 0) {
                        return erro(8, 'Informe a meta mensal de renda desejada.', elRenda);
                    }
                    return true;
                }
                if (n === 9) {
                    if (!escolhido('maiorMotivacao')) return erro(9, 'Selecione sua maior motivação.', grupo(9, 'maiorMotivacao'));
                    return true;
                }
                if (n === 10) {
                    if (!escolhido('habilidadeComercial')) return erro(10, 'Escolha uma nota de 0 a 10.', grupo(10, 'habilidadeComercial'));
                    return true;
                }
                if (n === 11) {
                    if (!$('#q_consentimento').checked) return erro(11, 'É necessário aceitar o consentimento para enviar.', $('#q_consentimento'));
                    return true;
                }
                return true;
            }

            /* ---------- Navegação ---------- */
            function irPara(n, validando) {
                if (validando && n > atual) {
                    for (let i = atual; i < n; i++) { if (!validar(i)) return; }
                }
                atual = n;
                $$('.wz-step').forEach(s => s.classList.remove('active'));
                passo(n).classList.add('active');

                const meta = ETAPAS[n - 1];
                $('#wzLabel').innerHTML = 'Etapa <b>' + n + '</b> de ' + TOTAL + ' — ' + meta.nome;
                $('#wzPct').textContent = meta.pct + '%';
                $('#wzFill').style.width = meta.pct + '%';
                $('.wz-progress-track').setAttribute('aria-valuenow', String(meta.pct));

                if (n === TOTAL) montarRevisao();

                const titulo = $('.wz-title', passo(n));
                if (titulo) { titulo.setAttribute('tabindex', '-1'); titulo.focus({ preventScroll: true }); }

                const topo = $('#formulario').getBoundingClientRect().top + window.pageYOffset - 80;
                window.scrollTo({ top: topo, behavior: 'smooth' });
            }

            $$('.wz-next').forEach(b => b.addEventListener('click', () => {
                if (validar(atual)) irPara(Math.min(atual + 1, TOTAL), false);
            }));
            $$('.wz-back').forEach(b => b.addEventListener('click', () => irPara(Math.max(atual - 1, 1), false)));

            $('#wzStart').addEventListener('click', () => {
                tela('intro').classList.remove('active');
                tela('wizard').classList.add('active');
                irPara(1, false);
            });
            $('#wzRestart').addEventListener('click', () => {
                tela('sucesso').classList.remove('active');
                tela('intro').classList.add('active');
                window.scrollTo({ top: $('#formulario').getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
            });

            form.addEventListener('keydown', e => {
                if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA' && atual < TOTAL) {
                    e.preventDefault();
                    if (validar(atual)) irPara(atual + 1, false);
                }
            });

            /* ---------- Coleta ---------- */
            const listaDe = nome => marcados(nome).map(c => c.value);
            function coletar() {
                return {
                    dadosPessoais: {
                        nome: $('#q_nome').value.trim(),
                        idade: $('#q_idade').value.trim(),
                        email: $('#q_email').value.trim(),
                        telefone: $('#q_telefone').value.trim(),
                        whatsapp: $('#q_whatsapp').value.trim()
                    },
                    localizacaoRedes: {
                        cidade: $('#q_cidade').value.trim(),
                        estado: $('#q_estado').value,
                        linkedin: $('#q_linkedin').value.trim(),
                        instagram: $('#q_instagram').value.trim()
                    },
                    qualificacao: {
                        atuacaoAtual: listaDe('atuacaoAtual'),
                        outraAtuacao: inOutra.value.trim(),
                        tempoExperienciaComercial: escolhido('tempoExperienciaComercial'),
                        areasExperiencia: listaDe('areasExperiencia'),
                        possuiCarteira: escolhido('possuiCarteira'),
                        quantidadeClientes: escolhido('quantidadeClientes'),
                        certificacoes: listaDe('certificacoes'),
                        horasSemanais: escolhido('horasSemanais'),
                        veiculoProprio: escolhido('veiculoProprio'),
                        possuiNotebook: escolhido('possuiNotebook'),
                        participaTreinamentos: escolhido('participaTreinamentos'),
                        rendaAtual: escolhido('rendaAtual'),
                        maiorMotivacao: escolhido('maiorMotivacao'),
                        habilidadeComercial: escolhido('habilidadeComercial'),
                        rendaDesejada12Meses: elRenda.value.trim()
                    }
                };
            }

            /* ---------- Revisão ---------- */
            const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            function montarRevisao() {
                const d = coletar();
                const q = d.qualificacao;
                const blocos = [
                    ['Dados pessoais', 1, [
                        ['Nome', d.dadosPessoais.nome], ['Idade', d.dadosPessoais.idade],
                        ['E-mail', d.dadosPessoais.email], ['Telefone', d.dadosPessoais.telefone],
                        ['WhatsApp', d.dadosPessoais.whatsapp]
                    ]],
                    ['Localização e redes', 2, [
                        ['Cidade', d.localizacaoRedes.cidade], ['Estado', d.localizacaoRedes.estado],
                        ['LinkedIn', d.localizacaoRedes.linkedin], ['Instagram', d.localizacaoRedes.instagram]
                    ]],
                    ['Atuação atual', 3, [
                        ['Áreas', q.atuacaoAtual.join(', ')], ['Outra', q.outraAtuacao]
                    ]],
                    ['Experiência comercial', 4, [
                        ['Tempo', q.tempoExperienciaComercial], ['Já trabalhou com', q.areasExperiencia.join(', ')]
                    ]],
                    ['Carteira de clientes', 5, [
                        ['Possui', q.possuiCarteira], ['Quantidade', q.quantidadeClientes]
                    ]],
                    ['Certificações', 6, [['Possui', q.certificacoes.join(', ')]]],
                    ['Estrutura e disponibilidade', 7, [
                        ['Horas por semana', q.horasSemanais], ['Veículo próprio', q.veiculoProprio],
                        ['Notebook', q.possuiNotebook], ['Capacitação', q.participaTreinamentos]
                    ]],
                    ['Momento financeiro', 8, [
                        ['Renda atual', q.rendaAtual], ['Meta em 12 meses', q.rendaDesejada12Meses]
                    ]],
                    ['Motivação', 9, [['Maior motivação', q.maiorMotivacao]]],
                    ['Autoavaliação', 10, [['Nota comercial', q.habilidadeComercial ? q.habilidadeComercial + ' de 10' : '']]]
                ];

                $('#wzReview').innerHTML = blocos.map(([titulo, etapa, linhas]) => {
                    const itens = linhas.filter(([, v]) => v !== undefined).map(([rot, val]) =>
                        '<dt>' + esc(rot) + '</dt><dd' + (val ? '' : ' class="empty"') + '>' + esc(val || 'não informado') + '</dd>'
                    ).join('');
                    return '<div class="review-block">' +
                        '<div class="review-head"><h4>' + esc(titulo) + '</h4>' +
                        '<button type="button" class="review-edit" data-goto="' + etapa + '">Editar</button></div>' +
                        '<dl class="review-dl">' + itens + '</dl></div>';
                }).join('');

                $$('.review-edit', $('#wzReview')).forEach(b =>
                    b.addEventListener('click', () => irPara(parseInt(b.dataset.goto, 10), false))
                );
            }

            /* ---------- Envio ---------- */
            const btnEnviar = $('#wzSubmit');
            const rotuloEnviar = btnEnviar.querySelector('span').textContent;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                if (enviando) return;
                if (!validar(11)) return;

                if (!ENDPOINT_QUALIFICACAO) {
                    erro(11, 'Envio ainda não configurado: defina ENDPOINT_QUALIFICACAO no topo do script. Nada foi enviado.');
                    return;
                }

                enviando = true;
                btnEnviar.disabled = true;
                btnEnviar.querySelector('span').textContent = 'Enviando...';

                try {
                    const resposta = await fetch(ENDPOINT_QUALIFICACAO, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            origem: 'LP Consultor Comercial',
                            enviadoEm: new Date().toISOString(),
                            ...coletar()
                        })
                    });
                    if (!resposta.ok) throw new Error('HTTP ' + resposta.status);

                    tela('wizard').classList.remove('active');
                    tela('sucesso').classList.add('active');
                    form.reset();
                    condOutra.classList.remove('open');
                    condQtd.classList.remove('open');
                    elZap.readOnly = false;
                    atual = 1;
                    window.scrollTo({ top: $('#formulario').getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
                } catch (falha) {
                    erro(11, 'Não foi possível enviar agora (' + falha.message + '). Tente novamente em instantes — suas respostas continuam preenchidas.');
                } finally {
                    enviando = false;
                    btnEnviar.disabled = false;
                    btnEnviar.querySelector('span').textContent = rotuloEnviar;
                }
            });
        })();
    </script>

</body>
</html>