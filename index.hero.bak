<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Investidor Protegido — Consultor Comercial</title>
    <meta name="description" content="Oportunidade de carreira como Consultor Comercial no mercado financeiro e consórcios.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@400;500;600;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #FFD400;
            --gold-soft: rgba(255,212,0,0.08);
            --gold-mid: rgba(255,212,0,0.15);
            --gold-line: rgba(255,212,0,0.25);
            --black: #050505;
            --black-soft: #0a0a0a;
            --black-elevated: #0f0f0f;
            --black-card: #111111;
            --white: #FFFFFF;
            --white-warm: #F5F3EF;
            --white-muted: rgba(255,255,255,0.55);
            --white-dim: rgba(255,255,255,0.35);
            --ink: #1a1a1a;
            --ink-muted: #555555;
            --ink-dim: #888888;
            --border-light: rgba(0,0,0,0.08);
            --font-display: 'Bebas Neue', sans-serif;
            --font-body: 'Montserrat', sans-serif;
            --font-serif: 'Cinzel', serif;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }

        body {
            font-family: var(--font-body);
            background: var(--black);
            color: var(--white);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::selection { background: var(--gold); color: var(--black); }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--black); }
        ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

        /* Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.12s; }
        .reveal-delay-2 { transition-delay: 0.24s; }
        .reveal-delay-3 { transition-delay: 0.36s; }
        .reveal-delay-4 { transition-delay: 0.48s; }
        .reveal-delay-5 { transition-delay: 0.6s; }

        .line-reveal {
            width: 0;
            height: 1px;
            background: var(--gold-line);
            transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .line-reveal.visible { width: 80px; }
        .line-reveal.center { margin: 0 auto; }
        .line-reveal.wide.visible { width: 120px; }

        /* Typography */
        .eyebrow {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            display: block;
            margin-bottom: 1.5rem;
        }

        .display-h1 {
            font-family: var(--font-display);
            font-size: clamp(4rem, 10vw, 9rem);
            line-height: 0.88;
            letter-spacing: 0.02em;
            color: var(--white);
            font-weight: 400;
        }

        .display-h2 {
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            line-height: 0.95;
            letter-spacing: 0.02em;
            color: var(--white);
            font-weight: 400;
        }

        .display-h3 {
            font-family: var(--font-display);
            font-size: clamp(1.5rem, 3vw, 2.5rem);
            line-height: 1.1;
            letter-spacing: 0.04em;
            color: var(--white);
            font-weight: 400;
        }

        .serif-quote {
            font-family: var(--font-serif);
            font-size: 0.8125rem;
            font-weight: 500;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold);
        }

        .body-text {
            font-family: var(--font-body);
            font-size: 1rem;
            line-height: 1.85;
            color: var(--white-muted);
            font-weight: 400;
        }

        .body-text-sm {
            font-family: var(--font-body);
            font-size: 0.875rem;
            line-height: 1.7;
            color: var(--white-dim);
            font-weight: 400;
        }

        .gold-accent { color: var(--gold); }

        /* Light section overrides */
        .section-light {
            background: var(--white-warm);
            color: var(--ink);
        }
        .section-light .display-h2,
        .section-light .display-h3 { color: var(--ink); }
        .section-light .body-text { color: var(--ink-muted); }
        .section-light .body-text-sm { color: var(--ink-dim); }
        .section-light .line-reveal { background: var(--gold); opacity: 0.4; }
        .section-light .card-premium {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .card-premium:hover {
            background: var(--white);
            border-color: rgba(0,0,0,0.12);
        }
        .section-light .card-premium-text { color: var(--ink-muted); }
        .section-light .segment-item {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .segment-item:hover {
            border-color: rgba(0,0,0,0.15);
            background: var(--white);
        }
        .section-light .segment-title { color: var(--ink); }
        .section-light .segment-desc { color: var(--ink-dim); }
        .section-light .journey-dot {
            background: var(--white-warm);
            border-color: rgba(0,0,0,0.2);
        }
        .section-light .journey-node:hover .journey-dot {
            background: var(--gold);
            border-color: var(--gold);
        }
        .section-light .journey-track::before {
            background: linear-gradient(90deg, transparent, rgba(0,0,0,0.15), transparent);
        }
        .section-light .journey-title { color: var(--ink); }
        .section-light .journey-desc { color: var(--ink-dim); }
        .section-light .highlight-cell {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .highlight-cell:hover { background: #fafafa; }
        .section-light .highlight-label { color: var(--ink-muted); }
        .section-light .form-frame {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .form-frame::before { background: var(--gold); opacity: 0.3; }
        .section-light .form-input {
            color: var(--ink);
            border-bottom-color: rgba(0,0,0,0.1);
        }
        .section-light .form-input::placeholder { color: var(--ink-dim); }
        .section-light .form-input:focus { border-bottom-color: var(--gold); }
        .section-light .form-group label { color: var(--ink-muted); }
        .section-light .form-option span { color: var(--ink-muted); }
        .section-light .form-file {
            border-color: rgba(0,0,0,0.1);
            background: var(--white-warm);
        }
        .section-light .form-file:hover {
            border-color: rgba(0,0,0,0.2);
            background: #f0eeea;
        }
        .section-light .form-file-text { color: var(--ink-dim); }
        .section-light .form-privacy {
            border-top-color: var(--border-light);
        }
        .section-light .form-privacy label { color: var(--ink-dim); }
        .section-light .btn-outline {
            border-color: rgba(0,0,0,0.15);
            color: var(--ink);
        }
        .section-light .btn-outline:hover {
            border-color: var(--gold);
            background: var(--gold-soft);
            color: var(--ink);
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .container-narrow {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1.125rem 2.5rem;
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 0;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            position: relative;
            overflow: hidden;
        }
        .btn-primary {
            background: var(--gold);
            color: var(--black);
        }
        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--white);
            transform: translateX(-101%);
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-primary:hover::before { transform: translateX(0); }
        .btn-primary span { position: relative; z-index: 1; }
        .btn-primary:hover { box-shadow: 0 8px 40px rgba(255,212,0,0.2); }
        .btn-outline {
            background: transparent;
            color: var(--gold);
            border: 1px solid var(--gold-line);
        }
        .btn-outline:hover {
            border-color: var(--gold);
            background: var(--gold-soft);
        }
        .btn-arrow::after {
            content: '→';
            font-size: 1.1em;
            transition: transform 0.3s;
        }
        .btn-arrow:hover::after { transform: translateX(4px); }

        /* Header */
        .header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            padding: 1.5rem 0;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .header.scrolled {
            background: rgba(5,5,5,0.92);
            backdrop-filter: blur(30px) saturate(1.2);
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255,212,0,0.06);
        }
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            text-decoration: none;
        }
        .logo-mark { width: 32px; height: 40px; }
        .logo-mark svg { width: 100%; height: 100%; }
        .logo-wordmark {
            font-family: var(--font-display);
            font-size: 1.25rem;
            letter-spacing: 0.15em;
            color: var(--white);
            line-height: 1;
        }
        .logo-wordmark span {
            display: block;
            font-family: var(--font-body);
            font-size: 0.5rem;
            font-weight: 500;
            letter-spacing: 0.35em;
            color: var(--gold);
            margin-top: 0.25rem;
            text-transform: uppercase;
        }
        .nav-desktop {
            display: flex;
            align-items: center;
            gap: 3rem;
        }
        .nav-desktop a {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--white-muted);
            text-decoration: none;
            transition: color 0.4s;
            position: relative;
        }
        .nav-desktop a::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--gold);
            transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-desktop a:hover { color: var(--white); }
        .nav-desktop a:hover::after { width: 100%; }
        .mobile-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--white);
            cursor: pointer;
            padding: 0.5rem;
        }
        .mobile-nav {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--black);
            z-index: 999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
        }
        .mobile-nav.active { display: flex; }
        .mobile-nav a {
            font-family: var(--font-display);
            font-size: 2.5rem;
            letter-spacing: 0.1em;
            color: var(--white);
            text-decoration: none;
        }
        .mobile-nav a.gold { color: var(--gold); }
        .mobile-nav .close { position: absolute; top: 1.5rem; right: 2rem; background: none; border: none; color: var(--white); font-size: 2rem; cursor: pointer; }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            position: relative;
            overflow: hidden;
            padding: 10rem 0 6rem;
        }
        .hero-media {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .hero-media img {
            width: 100%; height: 100%;
            object-fit: cover;
            filter: brightness(0.25) contrast(1.15) saturate(0.9);
            transform: scale(1.05);
            animation: heroZoom 20s ease-in-out infinite alternate;
        }
        @keyframes heroZoom {
            from { transform: scale(1.05); }
            to { transform: scale(1.12); }
        }
        .hero-vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 0%, rgba(5,5,5,0.7) 100%);
            z-index: 1;
        }
        .hero-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(5,5,5,0.4) 0%, rgba(5,5,5,0.1) 30%, rgba(5,5,5,0.6) 70%, rgba(5,5,5,0.95) 100%);
            z-index: 2;
        }
        .hero-content {
            position: relative;
            z-index: 3;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4rem;
        }
        .hero-graphic {
            opacity: 0.12;
            animation: float 8s ease-in-out infinite;
        }
        .hero-graphic svg { width: 200px; height: 200px; }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .hero-label {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.35em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.5rem;
            display: block;
        }
        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(4.5rem, 12vw, 11rem);
            line-height: 0.85;
            letter-spacing: 0.01em;
            color: var(--white);
            margin-bottom: 0.5rem;
        }
        .hero-title span { display: block; }
        .hero-subtitle {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3.5rem);
            line-height: 1;
            letter-spacing: 0.05em;
            color: var(--gold);
            margin-bottom: 2rem;
        }
        .hero-line {
            width: 60px;
            height: 1px;
            background: var(--gold-line);
            margin: 2rem 0;
        }
        .hero-desc {
            font-size: 1.0625rem;
            line-height: 1.8;
            color: var(--white-muted);
            max-width: 480px;
            margin-bottom: 2.5rem;
        }
        .hero-desc em {
            color: var(--gold);
            font-style: normal;
            font-weight: 500;
        }
        .hero-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 3rem;
        }
        .hero-motto {
            font-family: var(--font-serif);
            font-size: 0.75rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--white-dim);
            text-align: right;
            line-height: 2;
        }

        /* Section spacing */
        .section { padding: 10rem 0; position: relative; }
        .section-compact { padding: 7rem 0; }

        /* Editorial layouts */
        .editorial-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6rem;
            align-items: center;
        }
        .editorial-split.reverse { direction: rtl; }
        .editorial-split.reverse > * { direction: ltr; }
        .editorial-image {
            position: relative;
            overflow: hidden;
        }
        .editorial-image::before {
            content: '';
            position: absolute;
            inset: -1px;
            border: 1px solid var(--gold-line);
            z-index: 2;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.6s;
        }
        .editorial-image:hover::before { opacity: 1; }
        .editorial-image img {
            width: 100%;
            height: 600px;
            object-fit: cover;
            filter: brightness(0.6) contrast(1.1) saturate(0.85);
            transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s;
        }
        .editorial-image:hover img {
            transform: scale(1.04);
            filter: brightness(0.7) contrast(1.15) saturate(0.9);
        }
        .editorial-text { padding: 2rem 0; }

        /* Cards premium */
        .cards-premium {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
            margin-top: 4rem;
        }
        .card-premium {
            background: var(--black-card);
            border: 1px solid rgba(255,255,255,0.04);
            padding: 3rem 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .card-premium::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-line), transparent);
            opacity: 0;
            transition: opacity 0.6s;
        }
        .card-premium:hover {
            border-color: var(--gold-line);
            background: var(--black-elevated);
            transform: translateY(-4px);
        }
        .card-premium:hover::before { opacity: 1; }
        .card-premium-icon {
            width: 40px; height: 40px;
            margin: 0 auto 1.5rem;
            color: var(--gold);
            opacity: 0.7;
            transition: opacity 0.4s;
        }
        .card-premium:hover .card-premium-icon { opacity: 1; }
        .card-premium-icon svg { width: 100%; height: 100%; }
        .card-premium-text {
            font-family: var(--font-body);
            font-size: 0.8125rem;
            font-weight: 500;
            line-height: 1.5;
            color: var(--white-muted);
            letter-spacing: 0.02em;
        }
        .card-premium-text em {
            color: var(--gold);
            font-style: normal;
        }

        /* Pillars */
        .pillars-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            margin-top: 5rem;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .pillar-item {
            padding: 4rem 3rem;
            position: relative;
            transition: background 0.6s;
        }
        .pillar-item:not(:last-child) {
            border-right: 1px solid rgba(255,255,255,0.06);
        }
        .pillar-item:hover {
            background: var(--gold-soft);
        }
        .pillar-num {
            font-family: var(--font-serif);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.3em;
            color: var(--gold);
            margin-bottom: 1.5rem;
            display: block;
        }
        .pillar-title {
            font-family: var(--font-display);
            font-size: 2rem;
            letter-spacing: 0.05em;
            color: var(--white);
            margin-bottom: 1rem;
        }
        .pillar-desc {
            font-size: 0.875rem;
            line-height: 1.75;
            color: var(--white-dim);
        }

        /* Profile highlights grid */
        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: rgba(255,255,255,0.06);
            margin-top: 3rem;
        }
        .highlight-cell {
            background: var(--black);
            padding: 2rem;
            transition: background 0.4s;
        }
        .highlight-cell:hover { background: var(--black-elevated); }
        .highlight-icon {
            width: 24px; height: 24px;
            color: var(--gold);
            margin-bottom: 1rem;
            opacity: 0.6;
        }
        .highlight-label {
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white-muted);
        }

        /* Segments */
        .segments-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 4rem;
        }
        .segment-item {
            padding: 3rem 2rem;
            border: 1px solid rgba(255,255,255,0.04);
            position: relative;
            transition: all 0.5s;
        }
        .segment-item::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 0; height: 2px;
            background: var(--gold);
            transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .segment-item:hover {
            border-color: rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.01);
        }
        .segment-item:hover::after { width: 100%; }
        .segment-icon {
            width: 32px; height: 32px;
            color: var(--gold);
            margin-bottom: 1.5rem;
            opacity: 0.5;
        }
        .segment-item:hover .segment-icon { opacity: 1; }
        .segment-title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            letter-spacing: 0.05em;
            color: var(--white);
            margin-bottom: 0.75rem;
        }
        .segment-desc {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
        }

        /* Journey */
        .journey-track {
            display: flex;
            justify-content: center;
            gap: 0;
            margin-top: 4rem;
            position: relative;
        }
        .journey-track::before {
            content: '';
            position: absolute;
            top: 2rem;
            left: 15%;
            right: 15%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-line), transparent);
        }
        .journey-node {
            flex: 1;
            max-width: 280px;
            text-align: center;
            padding: 0 1.5rem;
            position: relative;
            z-index: 1;
        }
        .journey-dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            background: var(--black);
            border: 1px solid var(--gold-line);
            margin: 0 auto 2rem;
            position: relative;
            transition: all 0.4s;
        }
        .journey-dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 1px solid var(--gold-line);
            opacity: 0;
            transition: opacity 0.4s;
        }
        .journey-node:hover .journey-dot {
            background: var(--gold);
            border-color: var(--gold);
        }
        .journey-node:hover .journey-dot::after { opacity: 1; }
        .journey-title {
            font-family: var(--font-body);
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: 0.75rem;
        }
        .journey-desc {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
        }

        /* Form */
        .form-section {
            background: linear-gradient(180deg, var(--black) 0%, var(--black-soft) 100%);
            position: relative;
        }
        .form-section::before {
            content: '';
            position: absolute;
            top: 0; left: 50%;
            transform: translateX(-50%);
            width: 1px; height: 100px;
            background: linear-gradient(180deg, transparent, var(--gold-line));
        }
        .form-wrap {
            max-width: 720px;
            margin: 0 auto;
            position: relative;
        }
        .form-frame {
            border: 1px solid rgba(255,255,255,0.06);
            padding: 4rem;
            position: relative;
        }
        .form-frame::before {
            content: '';
            position: absolute;
            top: -1px; left: 3rem; right: 3rem;
            height: 1px;
            background: var(--gold-line);
        }
        .form-group { margin-bottom: 2rem; }
        .form-group label {
            display: block;
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--white-muted);
            margin-bottom: 0.75rem;
        }
        .form-group label .req { color: var(--gold); }
        .form-input {
            width: 100%;
            padding: 1rem 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            color: var(--white);
            font-family: var(--font-body);
            font-size: 0.9375rem;
            transition: border-color 0.4s;
            outline: none;
        }
        .form-input:focus { border-bottom-color: var(--gold); }
        .form-input::placeholder {
            color: var(--white-dim);
            font-weight: 300;
        }
        textarea.form-input {
            min-height: 100px;
            resize: vertical;
            line-height: 1.7;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .form-options {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            padding: 0.5rem 0;
        }
        .form-option {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            cursor: pointer;
        }
        .form-option input {
            width: 16px; height: 16px;
            accent-color: var(--gold);
            cursor: pointer;
        }
        .form-option span {
            font-size: 0.8125rem;
            color: var(--white-muted);
        }
        .form-file {
            position: relative;
            padding: 1.25rem;
            border: 1px dashed rgba(255,255,255,0.1);
            text-align: center;
            cursor: pointer;
            transition: all 0.4s;
        }
        .form-file:hover {
            border-color: var(--gold-line);
            background: var(--gold-soft);
        }
        .form-file input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }
        .form-file-text {
            font-size: 0.8125rem;
            color: var(--white-dim);
        }
        .form-file-text em {
            color: var(--gold);
            font-style: normal;
        }
        .form-privacy {
            display: flex;
            align-items: flex-start;
            gap: 0.875rem;
            padding: 1.5rem 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            margin-top: 2rem;
        }
        .form-privacy input {
            margin-top: 0.25rem;
            accent-color: var(--gold);
        }
        .form-privacy label {
            font-size: 0.75rem;
            line-height: 1.7;
            color: var(--white-dim);
        }
        .form-privacy a {
            color: var(--gold);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: border-color 0.3s;
        }
        .form-privacy a:hover { border-bottom-color: var(--gold); }
        .form-submit {
            width: 100%;
            margin-top: 1rem;
            padding: 1.25rem;
            font-size: 0.75rem;
        }

        /* Final CTA */
        .final-cta {
            min-height: 80vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .final-cta-media {
            position: absolute;
            inset: 0;
        }
        .final-cta-media img {
            width: 100%; height: 100%;
            object-fit: cover;
            filter: brightness(0.2) contrast(1.1);
        }
        .final-cta-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(5,5,5,0.8) 0%, rgba(5,5,5,0.4) 50%, rgba(5,5,5,0.85) 100%);
        }
        .final-cta-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Footer */
        .footer {
            background: var(--black);
            border-top: 1px solid rgba(255,255,255,0.04);
            padding: 5rem 0 2.5rem;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }
        .footer-brand .logo-wordmark { font-size: 1.125rem; }
        .footer-brand .logo-wordmark span { font-size: 0.4375rem; }
        .footer-tagline {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
            margin-top: 1.25rem;
            max-width: 280px;
        }
        .footer-title {
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.5rem;
        }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 0.875rem; }
        .footer-links a {
            font-size: 0.8125rem;
            color: var(--white-dim);
            text-decoration: none;
            transition: color 0.3s;
        }
        .footer-links a:hover { color: var(--white); }
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.04);
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .footer-copy {
            font-size: 0.6875rem;
            color: rgba(255,255,255,0.25);
            letter-spacing: 0.05em;
        }
        .footer-social {
            display: flex;
            gap: 0.75rem;
        }
        .footer-social a {
            width: 36px; height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.08);
            color: var(--white-dim);
            text-decoration: none;
            transition: all 0.4s;
        }
        .footer-social a:hover {
            border-color: var(--gold);
            color: var(--gold);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .cards-premium { grid-template-columns: repeat(3, 1fr); }
            .pillars-row { grid-template-columns: 1fr; }
            .pillar-item:not(:last-child) { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); }
            .editorial-split { gap: 3rem; }
            .segments-row { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 768px) {
            .nav-desktop { display: none; }
            .mobile-toggle { display: block; }
            .editorial-split { grid-template-columns: 1fr; }
            .editorial-split.reverse { direction: ltr; }
            .cards-premium { grid-template-columns: 1fr; }
            .highlights-grid { grid-template-columns: repeat(2, 1fr); }
            .journey-track { flex-direction: column; gap: 3rem; }
            .journey-track::before { display: none; }
            .form-row { grid-template-columns: 1fr; }
            .form-frame { padding: 2rem; }
            .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
            .section { padding: 6rem 0; }
            .hero-top { display: none; }
            .hero-bottom { flex-direction: column; gap: 2rem; align-items: flex-start; }
            .hero-motto { text-align: left; }
        }
        @media (max-width: 480px) {
            .display-h1 { font-size: 3.5rem; }
            .display-h2 { font-size: 2rem; }
            .hero-title { font-size: 3.5rem; }
            .container { padding: 0 1.25rem; }
        }

        /* ===== Formulário multietapas (qualificação) ===== */
        .wz-screen { display: none; }
        .wz-screen.active { display: block; }

        .wz-intro-title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 5vw, 2.75rem);
            line-height: 1.05;
            letter-spacing: 0.01em;
            color: var(--white);
            margin-bottom: 0.5rem;
        }
        .wz-intro-sub {
            font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.15em;
            text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem;
        }
        .wz-intro-desc { font-size: 0.9375rem; color: var(--white-muted); margin-bottom: 2.5rem; }

        /* Progresso */
        .wz-progress { margin-bottom: 3rem; }
        .wz-progress-head {
            display: flex; justify-content: space-between; align-items: baseline;
            gap: 1rem; margin-bottom: 0.875rem;
        }
        .wz-progress-label {
            font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.12em;
            text-transform: uppercase; color: var(--white-muted);
        }
        .wz-progress-label b { color: var(--gold); font-weight: 600; }
        .wz-progress-pct {
            font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--white-dim);
            font-variant-numeric: tabular-nums;
        }
        .wz-progress-track { height: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
        .wz-progress-fill {
            height: 100%; width: 0; background: var(--gold);
            transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Etapas */
        .wz-step { display: none; }
        .wz-step.active { display: block; }
        .wz-title {
            font-family: var(--font-display);
            font-size: clamp(1.6rem, 4vw, 2.125rem);
            line-height: 1.1; letter-spacing: 0.02em;
            color: var(--white); margin-bottom: 2.5rem;
        }
        .wz-q {
            display: block; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.15em;
            text-transform: uppercase; color: var(--white-muted); margin-bottom: 1rem;
        }
        .wz-q .req { color: var(--gold); }
        .wz-hint {
            font-size: 0.8125rem; color: var(--white-dim);
            margin: -0.5rem 0 1.25rem; line-height: 1.6;
        }

        /* Opções em pílula (substitui radio/checkbox nativos) */
        .opt-grid { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 2rem; }
        .opt-grid.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
        .opt { position: relative; cursor: pointer; }
        .opt input {
            position: absolute; opacity: 0; width: 1px; height: 1px;
            margin: 0; pointer-events: none;
        }
        .opt-face {
            display: block; padding: 0.875rem 1.25rem;
            border: 1px solid rgba(255,255,255,0.12);
            font-size: 0.8125rem; color: var(--white-muted);
            transition: border-color 0.25s, color 0.25s, background 0.25s;
            user-select: none;
        }
        .opt:hover .opt-face { border-color: var(--gold-line); color: var(--white); }
        .opt input:checked + .opt-face {
            border-color: var(--gold); color: var(--white);
            background: var(--gold-soft); font-weight: 500;
        }
        .opt input:focus-visible + .opt-face {
            outline: 2px solid var(--gold); outline-offset: 2px;
        }

        /* Checkbox em linha (consentimento / telefone=whatsapp) */
        .wz-check {
            display: flex; align-items: flex-start; gap: 0.75rem;
            cursor: pointer; margin-bottom: 2rem;
        }
        .wz-check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
        .wz-check-box {
            flex: 0 0 auto; width: 18px; height: 18px; margin-top: 2px;
            border: 1px solid rgba(255,255,255,0.25);
            position: relative; transition: all 0.25s;
        }
        .wz-check input:checked + .wz-check-box {
            background: var(--gold); border-color: var(--gold);
        }
        .wz-check input:checked + .wz-check-box::after {
            content: ''; position: absolute;
            left: 5px; top: 1px; width: 5px; height: 10px;
            border: solid var(--black); border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
        .wz-check input:focus-visible + .wz-check-box {
            outline: 2px solid var(--gold); outline-offset: 2px;
        }
        .wz-check-text { font-size: 0.8125rem; color: var(--white-muted); line-height: 1.6; }
        .wz-check-text a { color: var(--gold); text-decoration: underline; }

        /* Select nativo estilizado */
        select.form-input {
            appearance: none; -webkit-appearance: none;
            background-image: linear-gradient(45deg, transparent 50%, rgba(255,255,255,.45) 50%),
                              linear-gradient(135deg, rgba(255,255,255,.45) 50%, transparent 50%);
            background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%;
            background-size: 5px 5px, 5px 5px;
            background-repeat: no-repeat;
            padding-right: 2rem; cursor: pointer;
        }
        select.form-input option { background: var(--black-card); color: var(--white); }

        /* Escala 0–10 */
        .scale-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
        .scale-opt { position: relative; cursor: pointer; flex: 1 1 52px; }
        .scale-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
        .scale-face {
            display: flex; align-items: center; justify-content: center;
            height: 52px; border: 1px solid rgba(255,255,255,0.12);
            font-family: var(--font-display); font-size: 1.25rem;
            color: var(--white-muted); transition: all 0.25s;
            font-variant-numeric: tabular-nums;
        }
        .scale-opt:hover .scale-face { border-color: var(--gold-line); color: var(--white); }
        .scale-opt input:checked + .scale-face {
            background: var(--gold); border-color: var(--gold); color: var(--black);
        }
        .scale-opt input:focus-visible + .scale-face {
            outline: 2px solid var(--gold); outline-offset: 2px;
        }
        .scale-legend {
            display: flex; justify-content: space-between; gap: 1rem;
            font-size: 0.6875rem; color: var(--white-dim); margin-bottom: 2rem;
        }
        .scale-legend span:nth-child(2) { text-align: center; }
        .scale-legend span:last-child { text-align: right; }

        /* Condicionais */
        .wz-cond { display: none; }
        .wz-cond.open { display: block; }

        /* Erros */
        .wz-error {
            display: none; align-items: center; gap: 0.5rem;
            font-size: 0.8125rem; color: #FF8A7A;
            margin: -1.25rem 0 1.5rem;
        }
        .wz-error.show { display: flex; }
        .wz-invalid .opt-face,
        .form-input.wz-invalid { border-color: #FF8A7A; }

        /* Navegação */
        .wz-nav {
            display: flex; gap: 1rem; flex-wrap: wrap;
            padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.06);
        }
        .wz-nav .btn { flex: 1 1 auto; justify-content: center; }
        .btn-ghost {
            background: transparent; border: 1px solid rgba(255,255,255,0.15);
            color: var(--white-muted); flex: 0 1 auto !important;
        }
        .btn-ghost:hover { border-color: var(--gold-line); color: var(--white); }
        .btn[disabled] { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

        /* Revisão */
        .review-block {
            border: 1px solid rgba(255,255,255,0.08);
            padding: 1.25rem 1.5rem; margin-bottom: 0.75rem;
        }
        .review-head {
            display: flex; justify-content: space-between; align-items: center;
            gap: 1rem; margin-bottom: 0.875rem;
        }
        .review-head h4 {
            font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.15em;
            text-transform: uppercase; color: var(--gold);
        }
        .review-edit {
            background: none; border: none; cursor: pointer;
            font-family: var(--font-body); font-size: 0.6875rem; font-weight: 600;
            letter-spacing: 0.1em; text-transform: uppercase;
            color: var(--white-dim); border-bottom: 1px solid transparent;
            transition: color 0.25s, border-color 0.25s; padding: 0 0 2px;
        }
        .review-edit:hover { color: var(--gold); border-bottom-color: var(--gold); }
        .review-edit:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
        .review-dl { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1.25rem; }
        .review-dl dt {
            font-size: 0.75rem; color: var(--white-dim); white-space: nowrap;
        }
        .review-dl dd { font-size: 0.8125rem; color: var(--white); }
        .review-dl dd.empty { color: var(--white-dim); font-style: italic; }

        /* Confirmação */
        .wz-done { text-align: center; padding: 1rem 0; }
        .wz-done-mark {
            width: 56px; height: 56px; margin: 0 auto 2rem;
            border: 1px solid var(--gold); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; color: var(--gold);
        }
        .wz-done-title {
            font-family: var(--font-display);
            font-size: clamp(1.75rem, 4vw, 2.25rem); line-height: 1.1;
            color: var(--white); margin-bottom: 1rem;
        }
        .wz-done-desc {
            font-size: 0.9375rem; color: var(--white-muted);
            max-width: 46ch; margin: 0 auto 2rem;
        }
        .wz-done-inst {
            font-family: var(--font-serif); font-size: 0.9375rem;
            letter-spacing: 0.08em; color: var(--gold); margin-bottom: 2.5rem;
        }

        @media (max-width: 768px) {
            .form-frame { padding: 2rem 1.25rem; }
            .opt-grid.cols { grid-template-columns: 1fr; }
            .wz-nav { flex-direction: column-reverse; }
            .wz-nav .btn { width: 100%; }
            .scale-opt { flex: 1 1 40px; }
            .scale-face { height: 44px; font-size: 1rem; }
            .review-dl { grid-template-columns: 1fr; gap: 0.15rem; }
            .review-dl dd { margin-bottom: 0.6rem; }
        }
        @media (prefers-reduced-motion: reduce) {
            .wz-progress-fill { transition: none; }
        }

    </style>
<base target="_blank">
</head>
<body>

    <!-- Header -->
    <header class="header" id="header">
        <div class="header-inner">
            <a href="#" class="logo">
                <div class="logo-mark">
                    <svg viewBox="0 0 40 48" fill="none">
                        <path d="M20 2L4 10V22C4 33.5 20 46 20 46C20 46 36 33.5 36 22V10L20 2Z" fill="#FFD400" stroke="#FFD400" stroke-width="1"/>
                        <path d="M20 8L10 13V21C10 28.5 20 38 20 38C20 38 30 28.5 30 21V13L20 8Z" fill="#050505"/>
                        <rect x="16" y="16" width="8" height="12" rx="1" fill="#FFD400"/>
                    </svg>
                </div>
                <div class="logo-wordmark">
                    INVESTIDOR PROTEGIDO
                    <span>SOLUÇÕES FINANCEIRAS</span>
                </div>
            </a>
            <nav class="nav-desktop">
                <a href="#oportunidade">A oportunidade</a>
                <a href="#perfil">Perfil valorizado</a>
                <a href="#sobre">Sobre a empresa</a>
                <a href="#formulario" class="btn btn-outline">Quero me candidatar</a>
            </nav>
            <button class="mobile-toggle" onclick="toggleMobile()" aria-label="Menu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="4" y1="8" x2="20" y2="8"/>
                    <line x1="4" y1="16" x2="20" y2="16"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- Mobile Nav -->
    <div class="mobile-nav" id="mobileNav">
        <button class="close" onclick="toggleMobile()">&times;</button>
        <a href="#oportunidade" onclick="toggleMobile()">A oportunidade</a>
        <a href="#perfil" onclick="toggleMobile()">Perfil valorizado</a>
        <a href="#sobre" onclick="toggleMobile()">Sobre a empresa</a>
        <a href="#formulario" class="gold" onclick="toggleMobile()">Quero me candidatar</a>
    </div>

    <!-- Hero -->
    <section class="hero" id="hero">
        <div class="hero-media">
            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1920&q=80" alt="Residência contemporânea de alto padrão à noite">
        </div>
        <div class="hero-vignette"></div>
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <div class="hero-top">
                <div class="reveal">
                    <span class="hero-label">Estamos contratando</span>
                </div>
                <div class="hero-graphic reveal reveal-delay-3">
                    <svg viewBox="0 0 200 200" fill="none">
                        <rect x="20" y="120" width="24" height="60" fill="#8A6930" opacity="0.3"/>
                        <rect x="56" y="90" width="24" height="90" fill="#8A6930" opacity="0.4"/>
                        <rect x="92" y="60" width="24" height="120" fill="#8A6930" opacity="0.5"/>
                        <rect x="128" y="30" width="24" height="150" fill="#8A6930" opacity="0.6"/>
                        <rect x="164" y="10" width="24" height="170" fill="#8A6930" opacity="0.7"/>
                        <path d="M28 112L176 18" stroke="#D6A638" stroke-width="1.5" opacity="0.5"/>
                        <polygon points="176,18 168,22 172,30" fill="#D6A638" opacity="0.5"/>
                    </svg>
                </div>
            </div>
            <h1 class="hero-title reveal reveal-delay-1">
                <span>CONSULTOR</span>
                <span>COMERCIAL</span>
            </h1>
