<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Investidor Protegido — Consultor Comercial</title>
    <meta name="description" content="Oportunidade de carreira como Consultor Comercial no mercado financeiro e consórcios.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cinzel:wght@400;500;600;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #FFD400;
            --gold-soft: rgba(255,212,0,0.08);
            --gold-mid: rgba(255,212,0,0.15);
            --gold-line: rgba(255,212,0,0.25);
            --black: #050505;
            --black-soft: #0a0a0a;
            --black-elevated: #0f0f0f;
            --black-card: #111111;
            --white: #FFFFFF;
            --white-warm: #F5F3EF;
            --white-muted: rgba(255,255,255,0.55);
            --white-dim: rgba(255,255,255,0.35);
            --ink: #1a1a1a;
            --ink-muted: #555555;
            --ink-dim: #888888;
            --border-light: rgba(0,0,0,0.08);
            --font-display: 'Bebas Neue', sans-serif;
            --font-body: 'Montserrat', sans-serif;
            --font-serif: 'Cinzel', serif;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }

        body {
            font-family: var(--font-body);
            background: var(--black);
            color: var(--white);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::selection { background: var(--gold); color: var(--black); }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--black); }
        ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

        /* Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.12s; }
        .reveal-delay-2 { transition-delay: 0.24s; }
        .reveal-delay-3 { transition-delay: 0.36s; }
        .reveal-delay-4 { transition-delay: 0.48s; }
        .reveal-delay-5 { transition-delay: 0.6s; }

        .line-reveal {
            width: 0;
            height: 1px;
            background: var(--gold-line);
            transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .line-reveal.visible { width: 80px; }
        .line-reveal.center { margin: 0 auto; }
        .line-reveal.wide.visible { width: 120px; }

        /* Typography */
        .eyebrow {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            display: block;
            margin-bottom: 1.5rem;
        }

        .display-h1 {
            font-family: var(--font-display);
            font-size: clamp(4rem, 10vw, 9rem);
            line-height: 0.88;
            letter-spacing: 0.02em;
            color: var(--white);
            font-weight: 400;
        }

        .display-h2 {
            font-family: var(--font-display);
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            line-height: 0.95;
            letter-spacing: 0.02em;
            color: var(--white);
            font-weight: 400;
        }

        .display-h3 {
            font-family: var(--font-display);
            font-size: clamp(1.5rem, 3vw, 2.5rem);
            line-height: 1.1;
            letter-spacing: 0.04em;
            color: var(--white);
            font-weight: 400;
        }

        .serif-quote {
            font-family: var(--font-serif);
            font-size: 0.8125rem;
            font-weight: 500;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold);
        }

        .body-text {
            font-family: var(--font-body);
            font-size: 1rem;
            line-height: 1.85;
            color: var(--white-muted);
            font-weight: 400;
        }

        .body-text-sm {
            font-family: var(--font-body);
            font-size: 0.875rem;
            line-height: 1.7;
            color: var(--white-dim);
            font-weight: 400;
        }

        .gold-accent { color: var(--gold); }

        /* Light section overrides */
        .section-light {
            background: var(--white-warm);
            color: var(--ink);
        }
        .section-light .display-h2,
        .section-light .display-h3 { color: var(--ink); }
        .section-light .body-text { color: var(--ink-muted); }
        .section-light .body-text-sm { color: var(--ink-dim); }
        .section-light .line-reveal { background: var(--gold); opacity: 0.4; }
        .section-light .card-premium {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .card-premium:hover {
            background: var(--white);
            border-color: rgba(0,0,0,0.12);
        }
        .section-light .card-premium-text { color: var(--ink-muted); }
        .section-light .segment-item {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .segment-item:hover {
            border-color: rgba(0,0,0,0.15);
            background: var(--white);
        }
        .section-light .segment-desc { color: var(--ink-dim); }
        .section-light .journey-dot {
            background: var(--white-warm);
            border-color: rgba(0,0,0,0.2);
        }
        .section-light .journey-node:hover .journey-dot {
            background: var(--gold);
            border-color: var(--gold);
        }
        .section-light .journey-track::before {
            background: linear-gradient(90deg, transparent, rgba(0,0,0,0.15), transparent);
        }
        .section-light .journey-title { color: var(--ink); }
        .section-light .journey-desc { color: var(--ink-dim); }
        .section-light .highlight-cell {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .highlight-cell:hover { background: #fafafa; }
        .section-light .highlight-label { color: var(--ink-muted); }
        .section-light .form-frame {
            background: var(--white);
            border-color: var(--border-light);
        }
        .section-light .form-frame::before { background: var(--gold); opacity: 0.3; }
        .section-light .form-input {
            color: var(--ink);
            border-bottom-color: rgba(0,0,0,0.1);
        }
        .section-light .form-input::placeholder { color: var(--ink-dim); }
        .section-light .form-input:focus { border-bottom-color: var(--gold); }
        .section-light .form-group label { color: var(--ink-muted); }
        .section-light .form-option span { color: var(--ink-muted); }
        .section-light .form-file {
            border-color: rgba(0,0,0,0.1);
            background: var(--white-warm);
        }
        .section-light .form-file:hover {
            border-color: rgba(0,0,0,0.2);
            background: #f0eeea;
        }
        .section-light .form-file-text { color: var(--ink-dim); }
        .section-light .form-privacy {
            border-top-color: var(--border-light);
        }
        .section-light .form-privacy label { color: var(--ink-dim); }
        .section-light .btn-outline {
            border-color: rgba(0,0,0,0.15);
            color: var(--ink);
        }
        .section-light .btn-outline:hover {
            border-color: var(--gold);
            background: var(--gold-soft);
            color: var(--ink);
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .container-narrow {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1.125rem 2.5rem;
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 0;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            position: relative;
            overflow: hidden;
        }
        .btn-primary {
            background: var(--gold);
            color: var(--black);
        }
        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--white);
            transform: translateX(-101%);
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-primary:hover::before { transform: translateX(0); }
        .btn-primary span { position: relative; z-index: 1; }
        .btn-primary:hover { box-shadow: 0 8px 40px rgba(255,212,0,0.2); }
        .btn-outline {
            background: transparent;
            color: var(--gold);
            border: 1px solid var(--gold-line);
        }
        .btn-outline:hover {
            border-color: var(--gold);
            background: var(--gold-soft);
        }
        .btn-arrow::after {
            content: '→';
            font-size: 1.1em;
            transition: transform 0.3s;
        }
        .btn-arrow:hover::after { transform: translateX(4px); }

        /* Header */
        .header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            padding: 1.5rem 0;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .header.scrolled {
            background: rgba(5,5,5,0.92);
            backdrop-filter: blur(30px) saturate(1.2);
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255,212,0,0.06);
        }
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 0.875rem;
            text-decoration: none;
        }
        .logo-mark { width: 32px; height: 40px; }
        .logo-mark svg { width: 100%; height: 100%; }
        .logo-wordmark {
            font-family: var(--font-display);
            font-size: 1.25rem;
            letter-spacing: 0.15em;
            color: var(--white);
            line-height: 1;
        }
        .logo-wordmark span {
            display: block;
            font-family: var(--font-body);
            font-size: 0.5rem;
            font-weight: 500;
            letter-spacing: 0.35em;
            color: var(--gold);
            margin-top: 0.25rem;
            text-transform: uppercase;
        }
        .nav-desktop {
            display: flex;
            align-items: center;
            gap: 3rem;
        }
        .nav-desktop a {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--white-muted);
            text-decoration: none;
            transition: color 0.4s;
            position: relative;
        }
        .nav-desktop a::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--gold);
            transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .nav-desktop a:hover { color: var(--white); }
        .nav-desktop a:hover::after { width: 100%; }
        .mobile-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--white);
            cursor: pointer;
            padding: 0.5rem;
        }
        .mobile-nav {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--black);
            z-index: 999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
        }
        .mobile-nav.active { display: flex; }
        .mobile-nav a {
            font-family: var(--font-display);
            font-size: 2.5rem;
            letter-spacing: 0.1em;
            color: var(--white);
            text-decoration: none;
        }
        .mobile-nav a.gold { color: var(--gold); }
        .mobile-nav .close { position: absolute; top: 1.5rem; right: 2rem; background: none; border: none; color: var(--white); font-size: 2rem; cursor: pointer; }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            position: relative;
            overflow: hidden;
            padding: 10rem 0 6rem;
        }
        .hero-media {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .hero-media img {
            width: 100%; height: 100%;
            object-fit: cover;
            filter: brightness(0.25) contrast(1.15) saturate(0.9);
            transform: scale(1.05);
            animation: heroZoom 20s ease-in-out infinite alternate;
        }
        @keyframes heroZoom {
            from { transform: scale(1.05); }
            to { transform: scale(1.12); }
        }
        .hero-vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 0%, rgba(5,5,5,0.7) 100%);
            z-index: 1;
        }
        .hero-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(5,5,5,0.4) 0%, rgba(5,5,5,0.1) 30%, rgba(5,5,5,0.6) 70%, rgba(5,5,5,0.95) 100%);
            z-index: 2;
        }
        .hero-content {
            position: relative;
            z-index: 3;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4rem;
        }
        .hero-graphic {
            opacity: 0.12;
            animation: float 8s ease-in-out infinite;
        }
        .hero-graphic svg { width: 200px; height: 200px; }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }
        .hero-label {
            font-family: var(--font-body);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.35em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.5rem;
            display: block;
        }
        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(4.5rem, 12vw, 11rem);
            line-height: 0.85;
            letter-spacing: 0.01em;
            color: var(--white);
            margin-bottom: 0.5rem;
        }
        .hero-title span { display: block; }
        .hero-subtitle {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3.5rem);
            line-height: 1;
            letter-spacing: 0.05em;
            color: var(--gold);
            margin-bottom: 2rem;
        }
        .hero-line {
            width: 60px;
            height: 1px;
            background: var(--gold-line);
            margin: 2rem 0;
        }
        .hero-desc {
            font-size: 1.0625rem;
            line-height: 1.8;
            color: var(--white-muted);
            max-width: 480px;
            margin-bottom: 2.5rem;
        }
        .hero-desc em {
            color: var(--gold);
            font-style: normal;
            font-weight: 500;
        }
        .hero-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 3rem;
        }
        .hero-motto {
            font-family: var(--font-serif);
            font-size: 0.75rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--white-dim);
            text-align: right;
            line-height: 2;
        }

        /* Section spacing */
        .section { padding: 10rem 0; position: relative; }
        .section-compact { padding: 7rem 0; }

        /* Editorial layouts */
        .editorial-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6rem;
            align-items: center;
        }
        .editorial-split.reverse { direction: rtl; }
        .editorial-split.reverse > * { direction: ltr; }
        .editorial-image {
            position: relative;
            overflow: hidden;
        }
        .editorial-image::before {
            content: '';
            position: absolute;
            inset: -1px;
            border: 1px solid var(--gold-line);
            z-index: 2;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.6s;
        }
        .editorial-image:hover::before { opacity: 1; }
        .editorial-image img {
            width: 100%;
            height: 600px;
            object-fit: cover;
            filter: brightness(0.6) contrast(1.1) saturate(0.85);
            transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s;
        }
        .editorial-image:hover img {
            transform: scale(1.04);
            filter: brightness(0.7) contrast(1.15) saturate(0.9);
        }
        .editorial-text { padding: 2rem 0; }

        /* Cards premium */
        .cards-premium {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
            margin-top: 4rem;
        }
        .card-premium {
            background: var(--black-card);
            border: 1px solid rgba(255,255,255,0.04);
            padding: 3rem 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .card-premium::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-line), transparent);
            opacity: 0;
            transition: opacity 0.6s;
        }
        .card-premium:hover {
            border-color: var(--gold-line);
            background: var(--black-elevated);
            transform: translateY(-4px);
        }
        .card-premium:hover::before { opacity: 1; }
        .card-premium-icon {
            width: 40px; height: 40px;
            margin: 0 auto 1.5rem;
            color: var(--gold);
            opacity: 0.7;
            transition: opacity 0.4s;
        }
        .card-premium:hover .card-premium-icon { opacity: 1; }
        .card-premium-icon svg { width: 100%; height: 100%; }
        .card-premium-text {
            font-family: var(--font-body);
            font-size: 0.8125rem;
            font-weight: 500;
            line-height: 1.5;
            color: var(--white-muted);
            letter-spacing: 0.02em;
        }
        .card-premium-text em {
            color: var(--gold);
            font-style: normal;
        }

        /* Pillars */
        .pillars-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            margin-top: 5rem;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .pillar-item {
            padding: 4rem 3rem;
            position: relative;
            transition: background 0.6s;
        }
        .pillar-item:not(:last-child) {
            border-right: 1px solid rgba(255,255,255,0.06);
        }
        .pillar-item:hover {
            background: var(--gold-soft);
        }
        .pillar-num {
            font-family: var(--font-serif);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.3em;
            color: var(--gold);
            margin-bottom: 1.5rem;
            display: block;
        }
        .pillar-title {
            font-family: var(--font-display);
            font-size: 2rem;
            letter-spacing: 0.05em;
            color: var(--white);
            margin-bottom: 1rem;
        }
        .pillar-desc {
            font-size: 0.875rem;
            line-height: 1.75;
            color: var(--white-dim);
        }

        /* Profile highlights grid */
        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: rgba(255,255,255,0.06);
            margin-top: 3rem;
        }
        .highlight-cell {
            background: var(--black);
            padding: 2rem;
            transition: background 0.4s;
        }
        .highlight-cell:hover { background: var(--black-elevated); }
        .highlight-icon {
            width: 24px; height: 24px;
            color: var(--gold);
            margin-bottom: 1rem;
            opacity: 0.6;
        }
        .highlight-label {
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white-muted);
        }

        /* Segments */
        .segments-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 4rem;
        }
        .segment-item {
            padding: 3rem 2rem;
            border: 1px solid rgba(255,255,255,0.04);
            position: relative;
            transition: all 0.5s;
        }
        .segment-item::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 0; height: 2px;
            background: var(--gold);
            transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .segment-item:hover {
            border-color: rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.01);
        }
        .segment-item:hover::after { width: 100%; }
        .segment-icon {
            width: 32px; height: 32px;
            color: var(--gold);
            margin-bottom: 1.5rem;
            opacity: 0.5;
        }
        .segment-item:hover .segment-icon { opacity: 1; }
        .segment-title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            letter-spacing: 0.05em;
            color: var(--white);
            margin-bottom: 0.75rem;
        }
        .segment-desc {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
        }

        /* Journey */
        .journey-track {
            display: flex;
            justify-content: center;
            gap: 0;
            margin-top: 4rem;
            position: relative;
        }
        .journey-track::before {
            content: '';
            position: absolute;
            top: 2rem;
            left: 15%;
            right: 15%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-line), transparent);
        }
        .journey-node {
            flex: 1;
            max-width: 280px;
            text-align: center;
            padding: 0 1.5rem;
            position: relative;
            z-index: 1;
        }
        .journey-dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            background: var(--black);
            border: 1px solid var(--gold-line);
            margin: 0 auto 2rem;
            position: relative;
            transition: all 0.4s;
        }
        .journey-dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 1px solid var(--gold-line);
            opacity: 0;
            transition: opacity 0.4s;
        }
        .journey-node:hover .journey-dot {
            background: var(--gold);
            border-color: var(--gold);
        }
        .journey-node:hover .journey-dot::after { opacity: 1; }
        .journey-title {
            font-family: var(--font-body);
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: 0.75rem;
        }
        .journey-desc {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
        }

        /* Form */
        .form-section {
            background: linear-gradient(180deg, var(--black) 0%, var(--black-soft) 100%);
            position: relative;
        }
        .form-section::before {
            content: '';
            position: absolute;
            top: 0; left: 50%;
            transform: translateX(-50%);
            width: 1px; height: 100px;
            background: linear-gradient(180deg, transparent, var(--gold-line));
        }
        .form-wrap {
            max-width: 720px;
            margin: 0 auto;
            position: relative;
        }
        .form-frame {
            border: 1px solid rgba(255,255,255,0.06);
            padding: 4rem;
            position: relative;
        }
        .form-frame::before {
            content: '';
            position: absolute;
            top: -1px; left: 3rem; right: 3rem;
            height: 1px;
            background: var(--gold-line);
        }
        .form-group { margin-bottom: 2rem; }
        .form-group label {
            display: block;
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--white-muted);
            margin-bottom: 0.75rem;
        }
        .form-group label .req { color: var(--gold); }
        .form-input {
            width: 100%;
            padding: 1rem 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            color: var(--white);
            font-family: var(--font-body);
            font-size: 0.9375rem;
            transition: border-color 0.4s;
            outline: none;
        }
        .form-input:focus { border-bottom-color: var(--gold); }
        .form-input::placeholder {
            color: var(--white-dim);
            font-weight: 300;
        }
        textarea.form-input {
            min-height: 100px;
            resize: vertical;
            line-height: 1.7;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        .form-options {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            padding: 0.5rem 0;
        }
        .form-option {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            cursor: pointer;
        }
        .form-option input {
            width: 16px; height: 16px;
            accent-color: var(--gold);
            cursor: pointer;
        }
        .form-option span {
            font-size: 0.8125rem;
            color: var(--white-muted);
        }
        .form-file {
            position: relative;
            padding: 1.25rem;
            border: 1px dashed rgba(255,255,255,0.1);
            text-align: center;
            cursor: pointer;
            transition: all 0.4s;
        }
        .form-file:hover {
            border-color: var(--gold-line);
            background: var(--gold-soft);
        }
        .form-file input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }
        .form-file-text {
            font-size: 0.8125rem;
            color: var(--white-dim);
        }
        .form-file-text em {
            color: var(--gold);
            font-style: normal;
        }
        .form-privacy {
            display: flex;
            align-items: flex-start;
            gap: 0.875rem;
            padding: 1.5rem 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            margin-top: 2rem;
        }
        .form-privacy input {
            margin-top: 0.25rem;
            accent-color: var(--gold);
        }
        .form-privacy label {
            font-size: 0.75rem;
            line-height: 1.7;
            color: var(--white-dim);
        }
        .form-privacy a {
            color: var(--gold);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: border-color 0.3s;
        }
        .form-privacy a:hover { border-bottom-color: var(--gold); }
        .form-submit {
            width: 100%;
            margin-top: 1rem;
            padding: 1.25rem;
            font-size: 0.75rem;
        }

        /* Final CTA */
        .final-cta {
            min-height: 80vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .final-cta-media {
            position: absolute;
            inset: 0;
        }
        .final-cta-media img {
            width: 100%; height: 100%;
            object-fit: cover;
            filter: brightness(0.2) contrast(1.1);
        }
        .final-cta-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(5,5,5,0.8) 0%, rgba(5,5,5,0.4) 50%, rgba(5,5,5,0.85) 100%);
        }
        .final-cta-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Footer */
        .footer {
            background: var(--black);
            border-top: 1px solid rgba(255,255,255,0.04);
            padding: 5rem 0 2.5rem;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }
        .footer-brand .logo-wordmark { font-size: 1.125rem; }
        .footer-brand .logo-wordmark span { font-size: 0.4375rem; }
        .footer-tagline {
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--white-dim);
            margin-top: 1.25rem;
            max-width: 280px;
        }
        .footer-title {
            font-size: 0.625rem;
            font-weight: 700;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.5rem;
        }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 0.875rem; }
        .footer-links a {
            font-size: 0.8125rem;
            color: var(--white-dim);
            text-decoration: none;
            transition: color 0.3s;
        }
        .footer-links a:hover { color: var(--white); }
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.04);
            padding-top: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .footer-copy {
            font-size: 0.6875rem;
            color: rgba(255,255,255,0.25);
            letter-spacing: 0.05em;
        }
        .footer-social {
            display: flex;
            gap: 0.75rem;
        }
        .footer-social a {
            width: 36px; height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.08);
            color: var(--white-dim);
            text-decoration: none;
            transition: all 0.4s;
        }
        .footer-social a:hover {
            border-color: var(--gold);
            color: var(--gold);
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 2rem; right: 2rem;
            background: var(--black-elevated);
            border: 1px solid var(--gold-line);
            padding: 1.25rem 2rem;
            display: flex;
            align-items: center;
            gap: 0.875rem;
            z-index: 9999;
            transform: translateY(120px);
            opacity: 0;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast-icon { width: 20px; height: 20px; color: var(--gold); }
        .toast-msg { font-size: 0.8125rem; font-weight: 500; color: var(--white); }

        /* Responsive */
        @media (max-width: 1024px) {
            .cards-premium { grid-template-columns: repeat(3, 1fr); }
            .pillars-row { grid-template-columns: 1fr; }
            .pillar-item:not(:last-child) { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); }
            .editorial-split { gap: 3rem; }
            .segments-row { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 768px) {
            .nav-desktop { display: none; }
            .mobile-toggle { display: block; }
            .editorial-split { grid-template-columns: 1fr; }
            .editorial-split.reverse { direction: ltr; }
            .cards-premium { grid-template-columns: 1fr; }
            .highlights-grid { grid-template-columns: repeat(2, 1fr); }
            .journey-track { flex-direction: column; gap: 3rem; }
            .journey-track::before { display: none; }
            .form-row { grid-template-columns: 1fr; }
            .form-frame { padding: 2rem; }
            .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
            .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
            .section { padding: 6rem 0; }
            .hero-top { display: none; }
            .hero-bottom { flex-direction: column; gap: 2rem; align-items: flex-start; }
            .hero-motto { text-align: left; }
        }
        @media (max-width: 480px) {
            .display-h1 { font-size: 3.5rem; }
            .display-h2 { font-size: 2rem; }
            .hero-title { font-size: 3.5rem; }
            .container { padding: 0 1.25rem; }
        }
    </style>
<base target="_blank">
</head>
<body>

    <!-- Header -->
    <header class="header" id="header">
        <div class="header-inner">
            <a href="#" class="logo">
                <div class="logo-mark">
                    <svg viewBox="0 0 40 48" fill="none">
                        <path d="M20 2L4 10V22C4 33.5 20 46 20 46C20 46 36 33.5 36 22V10L20 2Z" fill="#FFD400" stroke="#FFD400" stroke-width="1"/>
                        <path d="M20 8L10 13V21C10 28.5 20 38 20 38C20 38 30 28.5 30 21V13L20 8Z" fill="#050505"/>
                        <rect x="16" y="16" width="8" height="12" rx="1" fill="#FFD400"/>
                    </svg>
                </div>
                <div class="logo-wordmark">
                    INVESTIDOR PROTEGIDO
                    <span>SOLUÇÕES FINANCEIRAS</span>
                </div>
            </a>
            <nav class="nav-desktop">
                <a href="#oportunidade">A oportunidade</a>
                <a href="#perfil">Perfil valorizado</a>
                <a href="#sobre">Sobre a empresa</a>
                <a href="#formulario" class="btn btn-outline">Quero me candidatar</a>
            </nav>
            <button class="mobile-toggle" onclick="toggleMobile()" aria-label="Menu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="4" y1="8" x2="20" y2="8"/>
                    <line x1="4" y1="16" x2="20" y2="16"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- Mobile Nav -->
    <div class="mobile-nav" id="mobileNav">
        <button class="close" onclick="toggleMobile()">&times;</button>
        <a href="#oportunidade" onclick="toggleMobile()">A oportunidade</a>
        <a href="#perfil" onclick="toggleMobile()">Perfil valorizado</a>
        <a href="#sobre" onclick="toggleMobile()">Sobre a empresa</a>
        <a href="#formulario" class="gold" onclick="toggleMobile()">Quero me candidatar</a>
    </div>

    <!-- Hero -->
    <section class="hero" id="hero">
        <div class="hero-media">
            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1920&q=80" alt="Residência contemporânea de alto padrão à noite">
        </div>
        <div class="hero-vignette"></div>
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <div class="hero-top">
                <div class="reveal">
                    <span class="hero-label">Estamos contratando</span>
                </div>
                <div class="hero-graphic reveal reveal-delay-3">
                    <svg viewBox="0 0 200 200" fill="none">
                        <rect x="20" y="120" width="24" height="60" fill="#8A6930" opacity="0.3"/>
                        <rect x="56" y="90" width="24" height="90" fill="#8A6930" opacity="0.4"/>
                        <rect x="92" y="60" width="24" height="120" fill="#8A6930" opacity="0.5"/>
                        <rect x="128" y="30" width="24" height="150" fill="#8A6930" opacity="0.6"/>
                        <rect x="164" y="10" width="24" height="170" fill="#8A6930" opacity="0.7"/>
                        <path d="M28 112L176 18" stroke="#D6A638" stroke-width="1.5" opacity="0.5"/>
                        <polygon points="176,18 168,22 172,30" fill="#D6A638" opacity="0.5"/>
                    </svg>
                </div>
            </div>
            <h1 class="hero-title reveal reveal-delay-1">
                <span>CONSULTOR</span>
                <span>COMERCIAL</span>
            </h1>
            <p class="hero-subtitle reveal reveal-delay-2">Mercado financeiro e consórcios</p>
            <div class="hero-line reveal reveal-delay-2"></div>
            <p class="hero-desc reveal reveal-delay-3">
                Ajude pessoas a construir patrimônio, organizar a vida financeira e <em>crescer com estratégia</em>.
            </p>
            <div class="hero-bottom">
                <a href="#formulario" class="btn btn-primary btn-arrow reveal reveal-delay-4"><span>Quero me candidatar</span></a>
                <p class="hero-motto reveal reveal-delay-5">
                    Planeje hoje.<br>Conquiste amanhã.
                </p>
            </div>
        </div>
    </section>

    <!-- Propósito — CLARO -->
    <section class="section section-light" id="oportunidade">
        <div class="container">
            <div class="editorial-split">
                <div class="editorial-text">
                    <span class="eyebrow reveal">Uma carreira com propósito</span>
                    <h2 class="display-h2 reveal reveal-delay-1">Ajude pessoas a planejarem hoje o que desejam conquistar amanhã</h2>
                    <div class="line-reveal reveal reveal-delay-2"></div>
                    <p class="body-text reveal reveal-delay-2" style="margin-top: 2rem;">
                        A oportunidade de Consultor Comercial está ligada à orientação de pessoas que desejam organizar sua vida financeira, planejar suas conquistas e construir patrimônio por meio de estratégia. A atuação acontece nos segmentos de mercado financeiro e consórcios, unindo relacionamento, conhecimento comercial e visão de futuro.
                    </p>
                    <div style="margin-top: 3rem;">
                        <a href="#formulario" class="btn btn-outline btn-arrow reveal reveal-delay-3"><span>Quero participar</span></a>
                    </div>
                </div>
                <div class="editorial-image reveal reveal-delay-2">
                    <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=800&q=80" alt="Consultor conversando com cliente">
                </div>
            </div>
        </div>
    </section>

    <!-- Diferenciais — ESCURO -->
    <section class="section" style="background: var(--black-soft);" id="perfil">
        <div class="container text-center">
            <span class="eyebrow reveal">Diferenciais que valorizamos</span>
            <h2 class="display-h2 reveal reveal-delay-1" style="max-width: 700px; margin: 0 auto 1rem;">
                Buscamos pessoas preparadas para criar relacionamentos e oportunidades
            </h2>
            <p class="body-text reveal reveal-delay-2" style="max-width: 600px; margin: 0 auto 3rem;">
                Procuramos profissionais com perfil comercial, capacidade de relacionamento e interesse em desenvolver uma trajetória no mercado financeiro e de consórcios.
            </p>
            <div class="line-reveal center reveal reveal-delay-2"></div>

            <div class="cards-premium">
                <div class="card-premium reveal reveal-delay-1">
                    <div class="card-premium-icon">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <rect x="8" y="28" width="8" height="12" rx="1"/>
                            <rect x="20" y="18" width="8" height="22" rx="1"/>
                            <rect x="32" y="8" width="8" height="32" rx="1"/>
                            <path d="M36 8L44 2" stroke-linecap="round"/>
                            <path d="M40 4L44 2L42 6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <p class="card-premium-text"><em>Experiência</em> em vendas</p>
                </div>
                <div class="card-premium reveal reveal-delay-2">
                    <div class="card-premium-icon">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <path d="M16 32C16 32 12 28 12 24C12 20 16 16 16 16"/>
                            <path d="M32 32C32 32 36 28 36 24C36 20 32 16 32 16"/>
                            <path d="M20 36L24 40L28 36"/>
                            <path d="M24 40V28"/>
                            <circle cx="24" cy="20" r="6"/>
                        </svg>
                    </div>
                    <p class="card-premium-text"><em>Conhecimento</em> em consórcios</p>
                </div>
                <div class="card-premium reveal reveal-delay-3">
                    <div class="card-premium-icon">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <rect x="6" y="18" width="36" height="22" rx="2"/>
                            <path d="M14 18V14C14 10 18 6 24 6C30 6 34 10 34 14V18"/>
                            <circle cx="24" cy="29" r="3"/>
                            <path d="M24 32V36"/>
                        </svg>
                    </div>
                    <p class="card-premium-text"><em>Vivência</em> no mercado financeiro</p>
                </div>
                <div class="card-premium reveal reveal-delay-4">
                    <div class="card-premium-icon">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <circle cx="16" cy="16" r="6"/>
                            <circle cx="32" cy="16" r="6"/>
                            <circle cx="24" cy="32" r="6"/>
                            <path d="M20 20l4 8"/>
                            <path d="M36 24l-2 10"/>
                        </svg>
                    </div>
                    <p class="card-premium-text"><em>Networking</em> estratégico</p>
                </div>
                <div class="card-premium reveal reveal-delay-5">
                    <div class="card-premium-icon">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
                            <path d="M24 4L28 18H42L31 26L35 40L24 32L13 40L17 26L6 18H20L24 4Z"/>
                        </svg>
                    </div>
                    <p class="card-premium-text"><em>Perfil</em> empreendedor</p>
                </div>
            </div>

            <div style="margin-top: 4rem;">
                <a href="#formulario" class="btn btn-primary btn-arrow reveal"><span>Eu tenho esse perfil</span></a>
            </div>
        </div>
    </section>

    <!-- Pilares — ESCURO -->
    <section class="section" style="background: var(--black-elevated);">
        <div class="container text-center">
            <span class="eyebrow reveal">Patrimônio • Liberdade • Legado</span>
            <h2 class="display-h2 reveal reveal-delay-1" style="max-width: 700px; margin: 0 auto 1rem;">
                Uma atuação comercial conectada às conquistas de cada cliente
            </h2>
            <p class="body-text reveal reveal-delay-2" style="max-width: 640px; margin: 0 auto;">
                O trabalho do Consultor Comercial vai além da apresentação de uma solução. Ele participa do planejamento de objetivos que podem representar patrimônio, liberdade e legado para cada cliente.
            </p>

            <div class="pillars-row">
                <div class="pillar-item reveal reveal-delay-1">
                    <span class="pillar-num">01</span>
                    <h3 class="pillar-title">PATRIMÔNIO</h3>
                    <p class="pillar-desc">Apoiar pessoas no planejamento de conquistas e na construção dos seus bens.</p>
                </div>
                <div class="pillar-item reveal reveal-delay-2">
                    <span class="pillar-num">02</span>
                    <h3 class="pillar-title">LIBERDADE</h3>
                    <p class="pillar-desc">Contribuir para uma vida financeira mais organizada e orientada por objetivos.</p>
                </div>
                <div class="pillar-item reveal reveal-delay-3">
                    <span class="pillar-num">03</span>
                    <h3 class="pillar-title">LEGADO</h3>
                    <p class="pillar-desc">Criar relacionamentos duradouros e participar de decisões importantes para o futuro dos clientes.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Perfil Profissional — ESCURO -->
    <section class="section" style="background: var(--black);">
        <div class="container">
            <div class="editorial-split reverse">
                <div class="editorial-image reveal">
                    <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80" alt="Profissional em evento de negócios">
                </div>
                <div class="editorial-text">
                    <span class="eyebrow reveal reveal-delay-1">Perfil empreendedor</span>
                    <h2 class="display-h2 reveal reveal-delay-1">Construa relacionamentos. Desenvolva oportunidades. Forme sua carteira.</h2>
                    <div class="line-reveal reveal reveal-delay-2"></div>
                    <p class="body-text reveal reveal-delay-2" style="margin-top: 2rem;">
                        Valorizamos profissionais com iniciativa, visão comercial e disposição para desenvolver uma rede de relacionamentos com empresários, profissionais liberais e investidores. A proposta da atuação é construir uma carteira própria por meio de relacionamento, conhecimento e estratégia comercial.
                    </p>

                    <div class="highlights-grid reveal reveal-delay-3">
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            <p class="highlight-label">Relacionamento</p>
                        </div>
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="M21 21l-4.35-4.35"/>
                            </svg>
                            <p class="highlight-label">Prospecção</p>
                        </div>
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                            <p class="highlight-label">Networking</p>
                        </div>
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 20V10"/>
                                <path d="M18 20V4"/>
                                <path d="M6 20v-4"/>
                            </svg>
                            <p class="highlight-label">Estratégia</p>
                        </div>
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            <p class="highlight-label">Carteira</p>
                        </div>
                        <div class="highlight-cell">
                            <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M23 6l-9.5 9.5-5-5L1 18"/>
                                <path d="M17 6h6v6"/>
                            </svg>
                            <p class="highlight-label">Crescimento</p>
                        </div>
                    </div>

                    <div style="margin-top: 3rem;">
                        <a href="#formulario" class="btn btn-outline btn-arrow reveal reveal-delay-4"><span>Apresentar meu perfil</span></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Segmentos — CLARO -->
    <section class="section section-light">
        <div class="container">
            <div class="text-center">
                <span class="eyebrow reveal">Mercado financeiro e consórcios</span>
                <h2 class="display-h2 reveal reveal-delay-1" style="max-width: 600px; margin: 0 auto 1rem;">
                    Conhecimento para orientar. Relacionamento para crescer.
                </h2>
                <p class="body-text reveal reveal-delay-2" style="max-width: 640px; margin: 0 auto;">
                    A oportunidade está direcionada a profissionais que tenham conhecimento em consórcios, vivência no mercado financeiro ou interesse em utilizar sua experiência comercial e sua rede de contatos nesse segmento.
                </p>
            </div>

            <div class="segments-row">
                <div class="segment-item reveal reveal-delay-1">
                    <svg class="segment-icon" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.2">
                        <rect x="8" y="12" width="40" height="32" rx="3"/>
                        <path d="M8 24h40"/>
                        <path d="M20 36h16"/>
                        <circle cx="28" cy="18" r="2"/>
                    </svg>
                    <h3 class="segment-title">Mercado financeiro</h3>
                    <p class="segment-desc">Usar experiência e conhecimento comercial para compreender objetivos e construir relacionamentos profissionais.</p>
                </div>
                <div class="segment-item reveal reveal-delay-2">
                    <svg class="segment-icon" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.2">
                        <rect x="10" y="8" width="36" height="40" rx="3"/>
                        <path d="M10 20h36"/>
                        <circle cx="20" cy="14" r="2"/>
                        <circle cx="28" cy="14" r="2"/>
                        <circle cx="36" cy="14" r="2"/>
                        <path d="M18 32l6 6 14-14"/>
                    </svg>
                    <h3 class="segment-title">Consórcios</h3>
                    <p class="segment-desc">Apresentar alternativas de planejamento relacionadas às conquistas e à construção de patrimônio.</p>
                </div>
                <div class="segment-item reveal reveal-delay-3">
                    <svg class="segment-icon" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.2">
                        <circle cx="20" cy="20" r="8"/>
                        <circle cx="40" cy="20" r="6"/>
                        <circle cx="30" cy="40" r="7"/>
                        <path d="M26 26l4 8"/>
                        <path d="M36 24l-2 10"/>
                    </svg>
                    <h3 class="segment-title">Relacionamento</h3>
                    <p class="segment-desc">Desenvolver conexões com empresários, profissionais liberais, investidores e demais clientes em potencial.</p>
                </div>
            </div>

            <div class="text-center" style="margin-top: 4rem;">
                <a href="#formulario" class="btn btn-primary btn-arrow reveal"><span>Quero atuar nesse mercado</span></a>
            </div>
        </div>
    </section>

    <!-- Jornada — CLARO -->
    <section class="section section-light" style="background: var(--white);">
        <div class="container text-center">
            <span class="eyebrow reveal">Dê o primeiro passo</span>
            <h2 class="display-h2 reveal reveal-delay-1" style="max-width: 600px; margin: 0 auto 1rem;">
                Apresente seu perfil para esta oportunidade
            </h2>
            <p class="body-text reveal reveal-delay-2" style="max-width: 600px; margin: 0 auto;">
                Se você possui experiência em vendas, conhecimento em consórcios, vivência no mercado financeiro, networking ou perfil empreendedor, queremos conhecer sua trajetória.
            </p>

            <div class="journey-track">
                <div class="journey-node reveal reveal-delay-1">
                    <div class="journey-dot"></div>
                    <h3 class="journey-title">Preencha seus dados</h3>
                    <p class="journey-desc">Complete o formulário com suas informações de contato e experiência profissional.</p>
                </div>
                <div class="journey-node reveal reveal-delay-2">
                    <div class="journey-dot"></div>
                    <h3 class="journey-title">Conte sua experiência</h3>
                    <p class="journey-desc">Descreva sua trajetória comercial, relacionamentos e interesse na oportunidade.</p>
                </div>
                <div class="journey-node reveal reveal-delay-3">
                    <div class="journey-dot"></div>
                    <h3 class="journey-title">Envie sua candidatura</h3>
                    <p class="journey-desc">Finalize o envio e aguarde a análise do seu perfil pela nossa equipe.</p>
                </div>
            </div>

            <div style="margin-top: 5rem;">
                <a href="#formulario" class="btn btn-outline btn-arrow reveal"><span>Iniciar minha candidatura</span></a>
            </div>
        </div>
    </section>

    <!-- Formulário — ESCURO -->
    <section class="section form-section" id="formulario">
        <div class="container">
            <div class="form-wrap">
                <div class="text-center" style="margin-bottom: 4rem;">
                    <span class="eyebrow reveal">Estamos contratando</span>
                    <h2 class="display-h2 reveal reveal-delay-1" style="max-width: 600px; margin: 0 auto 1rem;">
                        Candidate-se para Consultor Comercial
                    </h2>
                    <p class="body-text reveal reveal-delay-2" style="max-width: 560px; margin: 0 auto;">
                        Preencha o formulário abaixo e conte um pouco sobre sua experiência, seus relacionamentos profissionais e seu interesse em atuar no mercado financeiro e de consórcios.
                    </p>
                </div>

                <div class="form-frame reveal reveal-delay-2">
                    <form id="candidaturaForm" onsubmit="handleSubmit(event)">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nome completo <span class="req">*</span></label>
                                <input type="text" class="form-input" placeholder="Seu nome completo" required>
                            </div>
                            <div class="form-group">
                                <label>WhatsApp <span class="req">*</span></label>
                                <input type="tel" class="form-input" placeholder="(00) 00000-0000" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>E-mail <span class="req">*</span></label>
                                <input type="email" class="form-input" placeholder="seu@email.com" required>
                            </div>
                            <div class="form-group">
                                <label>Cidade e estado <span class="req">*</span></label>
                                <input type="text" class="form-input" placeholder="Ex: Brasília - DF" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Possui experiência em vendas?</label>
                            <div class="form-options">
                                <label class="form-option">
                                    <input type="radio" name="experiencia_vendas" value="sim">
                                    <span>Sim</span>
                                </label>
                                <label class="form-option">
                                    <input type="radio" name="experiencia_vendas" value="nao">
                                    <span>Não</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Possui conhecimento em consórcios?</label>
                            <div class="form-options">
                                <label class="form-option">
                                    <input type="radio" name="conhecimento_consorcios" value="sim">
                                    <span>Sim</span>
                                </label>
                                <label class="form-option">
                                    <input type="radio" name="conhecimento_consorcios" value="nao">
                                    <span>Não</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Possui vivência no mercado financeiro?</label>
                            <div class="form-options">
                                <label class="form-option">
                                    <input type="radio" name="vivencia_financeiro" value="sim">
                                    <span>Sim</span>
                                </label>
                                <label class="form-option">
                                    <input type="radio" name="vivencia_financeiro" value="nao">
                                    <span>Não</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Com quais públicos possui relacionamento?</label>
                            <div class="form-options">
                                <label class="form-option">
                                    <input type="checkbox" name="publicos" value="empresarios">
                                    <span>Empresários</span>
                                </label>
                                <label class="form-option">
                                    <input type="checkbox" name="publicos" value="liberais">
                                    <span>Profissionais liberais</span>
                                </label>
                                <label class="form-option">
                                    <input type="checkbox" name="publicos" value="investidores">
                                    <span>Investidores</span>
                                </label>
                                <label class="form-option">
                                    <input type="checkbox" name="publicos" value="outros">
                                    <span>Outros</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Possui carteira de clientes?</label>
                            <div class="form-options">
                                <label class="form-option">
                                    <input type="radio" name="carteira" value="sim">
                                    <span>Sim</span>
                                </label>
                                <label class="form-option">
                                    <input type="radio" name="carteira" value="nao">
                                    <span>Não</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Conte resumidamente sua experiência comercial</label>
                            <textarea class="form-input" placeholder="Descreva sua trajetória profissional, conquistas e habilidades comerciais..."></textarea>
                        </div>

                        <div class="form-group">
                            <label>Por que deseja atuar como Consultor Comercial?</label>
                            <textarea class="form-input" placeholder="Compartilhe sua motivação e expectativas com esta oportunidade..."></textarea>
                        </div>

                        <div class="form-group">
                            <label>Currículo (opcional)</label>
                            <div class="form-file">
                                <input type="file" id="curriculo" accept=".pdf,.doc,.docx">
                                <p class="form-file-text" id="fileLabel"><em>Clique para anexar</em> seu currículo (PDF, DOC, DOCX)</p>
                            </div>
                        </div>

                        <div class="form-privacy">
                            <input type="checkbox" id="privacy" required>
                            <label for="privacy">Li e concordo com a <a href="#">Política de Privacidade</a>. Seus dados serão utilizados exclusivamente para a análise da candidatura.</label>
                        </div>

                        <button type="submit" class="btn btn-primary form-submit"><span>Enviar minha candidatura</span></button>
                        <p class="body-text-sm" style="text-align: center; margin-top: 1.5rem;">Seus dados serão utilizados exclusivamente para a análise da candidatura, conforme a Política de Privacidade.</p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Final — ESCURO -->
    <section class="final-cta">
        <div class="final-cta-media">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80" alt="Pessoa caminhando em direção à entrada iluminada">
        </div>
        <div class="final-cta-overlay"></div>
        <div class="container">
            <div class="final-cta-content">
                <p class="serif-quote reveal" style="margin-bottom: 2rem;">Planeje hoje. Conquiste amanhã.</p>
                <h2 class="display-h2 reveal reveal-delay-1" style="margin-bottom: 1.5rem;">Seu próximo passo profissional pode começar aqui</h2>
                <p class="body-text reveal reveal-delay-2" style="margin-bottom: 3rem; color: var(--white-muted);">
                    Use sua experiência comercial, seu conhecimento e sua rede de relacionamentos para ajudar pessoas a construir patrimônio e crescer com estratégia.
                </p>
                <a href="#formulario" class="btn btn-primary btn-arrow reveal reveal-delay-3"><span>Quero me candidatar</span></a>
            </div>
        </div>
    </section>

    <!-- Footer — ESCURO -->
    <footer class="footer" id="sobre">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="#" class="logo">
                        <div class="logo-mark">
                            <svg viewBox="0 0 40 48" fill="none">
                                <path d="M20 2L4 10V22C4 33.5 20 46 20 46C20 46 36 33.5 36 22V10L20 2Z" fill="#FFD400" stroke="#FFD400" stroke-width="1"/>
                                <path d="M20 8L10 13V21C10 28.5 20 38 20 38C20 38 30 28.5 30 21V13L20 8Z" fill="#050505"/>
                                <rect x="16" y="16" width="8" height="12" rx="1" fill="#FFD400"/>
                            </svg>
                        </div>
                        <div class="logo-wordmark">
                            INVESTIDOR PROTEGIDO
                            <span>SOLUÇÕES FINANCEIRAS</span>
                        </div>
                    </a>
                    <p class="footer-tagline">Protegendo famílias e construindo um legado. O seu sonho é a nossa missão!</p>
                </div>
                <div>
                    <h4 class="footer-title">Navegação</h4>
                    <ul class="footer-links">
                        <li><a href="#oportunidade">A oportunidade</a></li>
                        <li><a href="#perfil">Perfil valorizado</a></li>
                        <li><a href="#formulario">Candidate-se</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer-title">Contato</h4>
                    <ul class="footer-links">
                        <li><a href="mailto:contato@investidorprotegido.com.br">contato@investidorprotegido.com.br</a></li>
                        <li><a href="https://investidorprotegido.com.br" target="_blank">investidorprotegido.com.br</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer-title">Redes sociais</h4>
                    <ul class="footer-links">
                        <li><a href="https://instagram.com/investidorprotegido" target="_blank">@investidorprotegido</a></li>
                        <li><a href="https://instagram.com/investidorprotegido.franquias" target="_blank">@investidorprotegido.franquias</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p class="footer-copy">© 2026 Investidor Protegido — Soluções Financeiras. Todos os direitos reservados.</p>
                <div class="footer-social">
                    <a href="https://instagram.com/investidorprotegido" target="_blank" aria-label="Instagram">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="2" y="2" width="20" height="20" rx="5"/>
                            <circle cx="12" cy="12" r="5"/>
                            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
                        </svg>
                    </a>
                    <a href="mailto:contato@investidorprotegido.com.br" aria-label="E-mail">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </a>
                    <a href="https://wa.me/" aria-label="WhatsApp">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Toast -->
    <div class="toast" id="toast">
        <svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span class="toast-msg" id="toastMsg">Candidatura enviada com sucesso!</span>
    </div>

    <script>
        function toggleMobile() {
            document.getElementById('mobileNav').classList.toggle('active');
            document.body.style.overflow = document.getElementById('mobileNav').classList.contains('active') ? 'hidden' : '';
        }

        window.addEventListener('scroll', () => {
            const h = document.getElementById('header');
            h.classList.toggle('scrolled', window.scrollY > 60);
        });

        const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

        document.querySelectorAll('.reveal, .line-reveal').forEach(el => obs.observe(el));

        document.getElementById('curriculo').addEventListener('change', function(e) {
            document.getElementById('fileLabel').innerHTML = e.target.files[0]?.name 
                ? '<em>Arquivo selecionado:</em> ' + e.target.files[0].name 
                : '<em>Clique para anexar</em> seu currículo (PDF, DOC, DOCX)';
        });

        function handleSubmit(e) {
            e.preventDefault();
            document.getElementById('toast').classList.add('show');
            e.target.reset();
            document.getElementById('fileLabel').innerHTML = '<em>Clique para anexar</em> seu currículo (PDF, DOC, DOCX)';
            setTimeout(() => document.getElementById('toast').classList.remove('show'), 4000);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href !== '#') {
                    e.preventDefault();
                    const t = document.querySelector(href);
                    if (t) window.scrollTo({ top: t.getBoundingClientRect().top + window.pageYOffset - 80, behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>