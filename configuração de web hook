9. Script de envio da landing page
async function sendApplication(payload) {
  if (
    !FORM_CONFIG.WEBHOOK_URL ||
    FORM_CONFIG.WEBHOOK_URL.includes(
      "COLE_AQUI"
    )
  ) {
    throw new Error(
      "webhook_nao_configurado"
    );
  }

  const controller = new AbortController();

  const timeout = window.setTimeout(
    () => controller.abort(),
    FORM_CONFIG.REQUEST_TIMEOUT
  );

  try {
    const response = await fetch(
      FORM_CONFIG.WEBHOOK_URL,
      {
        method: "POST",

        /*
         * text/plain evita uma requisição preliminar
         * desnecessária e o Apps Script interpreta o
         * conteúdo como JSON normalmente.
         */
        headers: {
          "Content-Type":
            "text/plain;charset=utf-8"
        },

        body: JSON.stringify(payload),
        redirect: "follow",
        signal: controller.signal
      }
    );

    if (!response.ok) {
      throw new Error(
        `webhook_http_${response.status}`
      );
    }

    const result = await response.json();

    if (!result.success) {
      const error = new Error(
        result.error || "webhook_rejeitou"
      );

      error.details = result;
      throw error;
    }

    return result;
  } finally {
    window.clearTimeout(timeout);
  }
}

10. Integração com o botão final
const qualificationForm = document.getElementById(
  FORM_CONFIG.FORM_ID
);

qualificationForm.addEventListener(
  "submit",
  async function(event) {
    event.preventDefault();

    const submitButton =
      qualificationForm.querySelector(
        '[type="submit"]'
      );

    if (submitButton.disabled) {
      return;
    }

    /*
     * Executa a validação final do formulário.
     */
    if (!qualificationForm.checkValidity()) {
      qualificationForm.reportValidity();

      window.dataLayer =
        window.dataLayer || [];

      window.dataLayer.push({
        event:
          "recrutamento_erro_validacao",

        nome_etapa:
          "revisao_consentimento",

        tipo_erro:
          "validacao_final_reprovada"
      });

      return;
    }

    const payload = buildApplicationPayload(
      qualificationForm
    );

    submitButton.disabled = true;
    submitButton.dataset.originalText =
      submitButton.textContent;
    submitButton.textContent = "Enviando...";

    window.dataLayer =
      window.dataLayer || [];

    window.dataLayer.push({
      event:
        "recrutamento_envio_iniciado",

      formulario:
        "qualificacao_consultor_comercial"
    });

    window.dataLayer.push({
      event:
        "recrutamento_validacao_aprovada",

      formulario:
        "qualificacao_consultor_comercial"
    });

    try {
      window.dataLayer.push({
        event:
          "recrutamento_requisicao_enviada",

        id_evento:
          payload.idCandidatura
      });

      const result = await sendApplication(
        payload
      );

      /*
       * A conversão só é enviada depois que
       * o Google Sheets confirma a gravação.
       */
      window.dataLayer.push({
        event:
          "recrutamento_lead_enviado",

        id_evento:
          result.applicationId,

        tipo_lead:
          "candidatura_consultor_comercial"
      });

      qualificationForm.reset();

      localStorage.removeItem(
        "recrutamento_form_rascunho"
      );

      showSuccessScreen();

      window.dataLayer.push({
        event:
          "recrutamento_sucesso_visualizado",

        id_evento:
          result.applicationId
      });
    } catch (error) {
      const errorType =
        error.name === "AbortError"
          ? "tempo_esgotado"
          : error.message;

      window.dataLayer.push({
        event:
          "recrutamento_erro_envio",

        tipo_erro:
          errorType
      });

      showSubmissionError(
        "Não foi possível enviar agora. Verifique sua conexão e tente novamente."
      );

      submitButton.disabled = false;
      submitButton.textContent =
        submitButton.dataset.originalText ||
        "Enviar minha qualificação";
    }
  }
);

