function doGet() {
  return jsonResponse({
    success: true,
    message: "Webhook de candidaturas ativo."
  });
}

function doPost(e) {
  const lock = LockService.getScriptLock();

  try {
    lock.waitLock(10000);

    if (!e || !e.postData || !e.postData.contents) {
      return jsonResponse({
        success: false,
        error: "corpo_ausente"
      });
    }

    const payload = JSON.parse(e.postData.contents);

    if (payload.website) {
      return jsonResponse({
        success: true,
        ignored: true
      });
    }

    const validation = validatePayload(payload);

    if (!validation.valid) {
      return jsonResponse({
        success: false,
        error: "dados_invalidos",
        fields: validation.fields
      });
    }

    const spreadsheet = SpreadsheetApp.openById(
      CONFIG.SPREADSHEET_ID
    );

    let sheet = spreadsheet.getSheetByName(
      CONFIG.SHEET_NAME
    );

    if (!sheet) {
      sheet = spreadsheet.insertSheet(
        CONFIG.SHEET_NAME
      );
    }

    ensureHeaders(sheet);

    const applicationId = cleanText(
      payload.idCandidatura
    );

    if (applicationExists(sheet, applicationId)) {
      return jsonResponse({
        success: true,
        duplicate: true,
        applicationId
      });
    }

    const row = [
      new Date(),
      applicationId,
      safeCell(payload.nome),
      safeCell(payload.telefone),
      safeCell(payload.whatsapp),
      safeCell(payload.cidade),
      safeCell(payload.estado),
      safeCell(payload.email),
      safeCell(payload.idade),
      joinValues(payload.atuacaoAtual),
      safeCell(payload.linkedin),
      safeCell(payload.instagram),
      safeCell(payload.outraAtuacao),
      safeCell(payload.tempoExperiencia),
      safeCell(payload.rendaMensal),
      safeCell(payload.maiorMotivacao),
      safeCell(payload.possuiCarteira),
      safeCell(payload.quantidadeClientes),
      joinValues(payload.areasExperiencia),
      joinValues(payload.certificacoes),
      safeCell(payload.dedicacaoSemanal),
      safeCell(payload.veiculoProprio),
      safeCell(payload.possuiNotebook),
      safeCell(payload.participaTreinamentos),
      safeCell(payload.habilidadeComercial),
      safeCell(payload.rendaDesejada),
      safeCell(payload.utmSource),
      safeCell(payload.utmMedium),
      safeCell(payload.utmCampaign),
      safeCell(payload.utmContent),
      safeCell(payload.utmTerm),
      safeCell(payload.paginaOrigem),
      "Nova candidatura"
    ];

    sheet.appendRow(row);

    return jsonResponse({
      success: true,
      applicationId,
      message: "Candidatura registrada."
    });
  } catch (error) {
    console.error(error);

    return jsonResponse({
      success: false,
      error: "erro_interno"
    });
  } finally {
    try {
      lock.releaseLock();
    } catch (error) {
      // O bloqueio pode não ter sido adquirido.
    }
  }
}

function validatePayload(payload) {
  const requiredFields = [
    "idCandidatura",
    "nome",
    "telefone",
    "whatsapp",
    "cidade",
    "estado",
    "email",
    "idade",
    "atuacaoAtual",
    "tempoExperiencia",
    "rendaMensal",
    "maiorMotivacao",
    "possuiCarteira",
    "areasExperiencia",
    "certificacoes",
    "dedicacaoSemanal",
    "veiculoProprio",
    "possuiNotebook",
    "participaTreinamentos",
    "habilidadeComercial",
    "rendaDesejada",
    "consentimento"
  ];

  const missingFields = requiredFields.filter(
    function(field) {
      const value = payload[field];

      if (Array.isArray(value)) {
        return value.length === 0;
      }

      return (
        value === undefined ||
        value === null ||
        String(value).trim() === ""
      );
    }
  );

  if (payload.consentimento !== true) {
    missingFields.push("consentimento");
  }

  if (
    payload.email &&
    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
      String(payload.email).trim()
    )
  ) {
    missingFields.push("email_invalido");
  }

  const age = Number(payload.idade);

  if (
    !Number.isInteger(age) ||
    age < 16 ||
    age > 100
  ) {
    missingFields.push("idade_invalida");
  }

  const commercialScore = Number(
    payload.habilidadeComercial
  );

  if (
    !Number.isFinite(commercialScore) ||
    commercialScore < 0 ||
    commercialScore > 10
  ) {
    missingFields.push(
      "habilidade_comercial_invalida"
    );
  }

  if (
    payload.possuiCarteira === "Sim" &&
    !String(
      payload.quantidadeClientes || ""
    ).trim()
  ) {
    missingFields.push("quantidadeClientes");
  }

  return {
    valid: missingFields.length === 0,
    fields: [...new Set(missingFields)]
  };
}

function ensureHeaders(sheet) {
  if (sheet.getLastRow() > 0) {
    return;
  }

  sheet
    .getRange(1, 1, 1, CONFIG.HEADERS.length)
    .setValues([CONFIG.HEADERS]);

  sheet.getRange(1, 1, 1, CONFIG.HEADERS.length)
    .setFontWeight("bold")
    .setBackground("#D6A638")
    .setFontColor("#080A0B");

  sheet.setFrozenRows(1);
}

function applicationExists(sheet, applicationId) {
  if (!applicationId || sheet.getLastRow() < 2) {
    return false;
  }

  const values = sheet
    .getRange(
      2,
      2,
      sheet.getLastRow() - 1,
      1
    )
    .getDisplayValues()
    .flat();

  return values.includes(applicationId);
}

function joinValues(value) {
  if (!Array.isArray(value)) {
    return safeCell(value);
  }

  return safeCell(value.join(" | "));
}

function cleanText(value) {
  return String(value ?? "").trim();
}

function safeCell(value) {
  const text = cleanText(value);

  /*
   * Impede que textos enviados pelo formulário
   * sejam interpretados como fórmulas no Sheets.
   */
  if (/^[=+\-@]/.test(text)) {
    return "'" + text;
  }

  return text;
}

function jsonResponse(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

O Apps Script utiliza doPost(e) para receber requisições e o ContentService para devolver JSON, conforme o modelo de web apps do Google. O LockService impede que duas submissões simultâneas disputem a mesma gravação. Web Apps, LockService.
